---
import { fetchSingleType, fetchCollection } from "../services/strapi";
import type { GlobalConfigAttributes } from "../types/global-config";
import type { BlogPageAttributes } from "../types/blog-page";
import type { BlogPostAttributes } from "../types/blog-post";
import PostLayout from "../layouts/PostLayout.astro";
import BlogCard from "../components/ui/BlogCard.astro";
import BlogAccordionItem from "../components/ui/BlogAccordionItem.astro";

const globalConfig = await fetchSingleType<GlobalConfigAttributes>(
  "global-config",
  "es",
  { populate: ["navigation", "social"] },
);

if (!globalConfig) {
  throw new Error("Failed to fetch global-config from Strapi");
}

const blogEs = await fetchSingleType<BlogPageAttributes>("blog-page", "es", {
  populate: "*",
});
const blogEn = await fetchSingleType<BlogPageAttributes>("blog-page", "en", {
  populate: "*",
});

if (!blogEs || !blogEn) {
  throw new Error("Failed to fetch blog-page from Strapi");
}

const blogPostsEs = await fetchCollection<BlogPostAttributes>(
  "blog-posts",
  "es",
  { populate: { category: true, featuredImage: true, headerImage: true } },
);
const blogPostsEn = await fetchCollection<BlogPostAttributes>(
  "blog-posts",
  "en",
  { populate: { category: true, featuredImage: true, headerImage: true } },
);

const lang = "es";
const posts = (blogPostsEs ?? []).map((p) => ({
  id: p.documentId,
  title: p.title,
  link: `/blog/${p.slug}`,
  category: p.category?.name || "",
  date: p.date,
  read_time: p.readTime,
  resume: p.resume,
  featuredImage: p.featuredImage || p.headerImage || undefined,
}));

const embeddedData = {
  es: {
    title: blogEs.title,
    intro: blogEs.intro,
    view_more: blogEs.view_more,
    posts: posts,
  },
  en: {
    title: blogEn.title,
    intro: blogEn.intro,
    view_more: blogEn.view_more,
    posts: (blogPostsEn ?? []).map((p) => ({
      id: p.documentId,
      title: p.title,
      link: `/blog/${p.slug}`,
      category: p.category?.name || "",
      date: p.date,
      read_time: p.readTime,
      resume: p.resume,
      featuredImage: p.featuredImage || p.headerImage || undefined,
    })),
  },
};
const blogDataJson = JSON.stringify(embeddedData);
---

<PostLayout
  title="Blog — Posts"
  lang={lang}
  navigation={globalConfig.navigation ?? []}
  defaultLocale={globalConfig.defaultLocale}
>
  <script
    is:inline
    type="application/json"
    id="blog-data"
    set:html={blogDataJson}
  />

  <section class="posts-page">
    <header class="posts-page__header">
      <h1 class="posts-page__title" data-i18n-content="section.blog">
        {blogEs.title}
      </h1>
    </header>

    <div class="posts-page__grid">
      {
        posts.map((post) => (
          <BlogCard
            id={post.id}
            title={post.title}
            link={post.link}
            category={post.category}
            date={post.date}
            readTime={post.read_time}
            resume={post.resume}
            featuredImage={post.featuredImage}
          />
        ))
      }
    </div>

    <div class="posts-page__accordion">
      {
        posts.map((post) => (
          <BlogAccordionItem
            id={post.id}
            title={post.title}
            link={post.link}
            category={post.category}
            resume={post.resume}
          />
        ))
      }
    </div>
  </section>
</PostLayout>

<script>
  import { initBlogLangSwitch, initBlogAccordion } from "../utils/blog.ts";
  initBlogLangSwitch();
  initBlogAccordion();
</script>

<style>
  .posts-page {
    width: 100%;
    max-width: 100%;
    padding: var(--spacing-xl) var(--spacing-lg);
  }

  .posts-page__header {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  .posts-page__title {
    font-family: var(--font-titles);
    font-size: var(--font-size-h2-mobile);
    font-weight: var(--weight-space-semibold);
    color: var(--text-base);
  }

  .posts-page__grid {
    display: none;
    gap: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    width: 100%;
  }

  .posts-page__accordion {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    width: 100%;
  }

  @media (min-width: 480px) {
    .posts-page__grid {
      grid-template-columns: repeat(2, 1fr);
      display: grid;
    }

    .posts-page__accordion {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .posts-page {
      padding: var(--spacing-xl);
    }

    .posts-page__title {
      font-size: var(--font-size-h2-desktop);
    }

    .posts-page__grid {
      grid-template-columns: repeat(3, 1fr);
      display: grid;
    }

    .posts-page__accordion {
      display: none;
    }
  }
</style>
