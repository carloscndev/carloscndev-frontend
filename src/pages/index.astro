---
import { fetchSingleType, fetchCollection } from "../services/strapi";
import type { GlobalConfigAttributes } from "../types/global-config";
import type { HomePageAttributes } from "../types/home-page";
import type { AboutPageAttributes } from "../types/about-page";
import type { ExperiencePageAttributes } from "../types/experience-page";
import type { PortfolioPageAttributes } from "../types/portfolio-page";
import type { BlogPageAttributes } from "../types/blog-page";
import type { BlogPostAttributes } from "../types/blog-post";
import type { ContactPageAttributes } from "../types/contact-page";
import { calculateReadingTime } from "../utils/reading-time";
import MainLayout from "../layouts/MainLayout.astro";
import Home from "../components/sections/Home.astro";
import About from "../components/sections/About.astro";
import Experience from "@components/sections/Experience.astro";
import Portfolio from "@components/sections/Portfolio.astro";
import Blog from "@components/sections/Blog.astro";
import Contact from "@components/sections/Contact.astro";

const globalConfig = await fetchSingleType<GlobalConfigAttributes>(
  "global-config",
  "es",
  { populate: ["navigation", "social"] },
);

if (!globalConfig) {
  throw new Error("Failed to fetch global-config from Strapi");
}

const homeEs = await fetchSingleType<HomePageAttributes>("home-page", "es", {
  populate: "*",
});
const homeEn = await fetchSingleType<HomePageAttributes>("home-page", "en", {
  populate: "*",
});

if (!homeEs || !homeEn) {
  throw new Error("Failed to fetch home-page from Strapi");
}

const siteUrl = Astro.site?.origin ?? "https://carloscndev.com";
const sameAs = (globalConfig.social ?? [])
  .filter((s) => ["github", "linkedin", "instagram"].includes(s.platform))
  .map((s) => s.url);

const aboutEs = await fetchSingleType<AboutPageAttributes>("about-page", "es", {
  populate: "*",
});
const aboutEn = await fetchSingleType<AboutPageAttributes>("about-page", "en", {
  populate: "*",
});

if (!aboutEs || !aboutEn) {
  throw new Error("Failed to fetch about-page from Strapi");
}

const homeData = {
  es: {
    intro: homeEs.intro,
    title: homeEs.title,
    subtitle: homeEs.subtitle,
    content: homeEs.content,
  },
  en: {
    intro: homeEn.intro,
    title: homeEn.title,
    subtitle: homeEn.subtitle,
    content: homeEn.content,
  },
};

const expEs = await fetchSingleType<ExperiencePageAttributes>(
  "experience-page",
  "es",
  { populate: "*" },
);
const expEn = await fetchSingleType<ExperiencePageAttributes>(
  "experience-page",
  "en",
  { populate: "*" },
);

if (!expEs || !expEn) {
  throw new Error("Failed to fetch experience-page from Strapi");
}

const aboutData = {
  es: {
    title: aboutEs.title,
    contentText: aboutEs.contentText,
    technologies: aboutEs.technologies.map((t) => ({
      name: t.name,
      icon: t.icon,
    })),
  },
  en: {
    title: aboutEn.title,
    contentText: aboutEn.contentText,
    technologies: aboutEn.technologies.map((t) => ({
      name: t.name,
      icon: t.icon,
    })),
  },
};

const expData = {
  es: {
    title: expEs.title,
    intro: expEs.intro,
    jobs: expEs.jobs.map((j) => ({
      id: j.id,
      company: j.company,
      company_url: j.company_url,
      role: j.role,
      period: j.period,
      description: j.description,
      technologies: j.technologies,
    })),
  },
  en: {
    title: expEn.title,
    intro: expEn.intro,
    jobs: expEn.jobs.map((j) => ({
      id: j.id,
      company: j.company,
      company_url: j.company_url,
      role: j.role,
      period: j.period,
      description: j.description,
      technologies: j.technologies,
    })),
  },
};

const portfolioEs = await fetchSingleType<PortfolioPageAttributes>(
  "portfolio-page",
  "es",
  { populate: { projects: { populate: "*" } } },
);
const portfolioEn = await fetchSingleType<PortfolioPageAttributes>(
  "portfolio-page",
  "en",
  { populate: { projects: { populate: "*" } } },
);

if (!portfolioEs || !portfolioEn) {
  throw new Error("Failed to fetch portfolio-page from Strapi");
}

// Debug: check first project structure with full populate

const portfolioData = {
  es: {
    title: portfolioEs.title,
    intro: portfolioEs.intro,
    view_more: portfolioEs.viewMore || portfolioEs.view_more,
    projects: (
      (portfolioEs.projects as any)?.data ??
      portfolioEs.projects ??
      []
    ).map((p: any) => {
      const linksObj: { repo?: string; demo?: string; article?: string } = {};
      if (Array.isArray(p.links)) {
        for (const link of p.links) {
          if (link.type === "repo") linksObj.repo = link.url;
          if (link.type === "demo") linksObj.demo = link.url;
          if (link.type === "article") linksObj.article = link.url;
        }
      }
      return {
        id: p.documentId || p.id,
        title: p.title,
        description: p.description,
        technologies: p.technologies || [],
        links: linksObj,
        coverImage: p.coverImage,
      };
    }),
  },
  en: {
    title: portfolioEn.title,
    intro: portfolioEn.intro,
    view_more: portfolioEn.viewMore || portfolioEn.view_more,
    projects: (
      (portfolioEn.projects as any)?.data ??
      portfolioEn.projects ??
      []
    ).map((p: any) => {
      const linksObj: { repo?: string; demo?: string; article?: string } = {};
      if (Array.isArray(p.links)) {
        for (const link of p.links) {
          if (link.type === "repo") linksObj.repo = link.url;
          if (link.type === "demo") linksObj.demo = link.url;
          if (link.type === "article") linksObj.article = link.url;
        }
      }
      return {
        id: p.documentId || p.id,
        title: p.title,
        description: p.description,
        technologies: p.technologies || [],
        links: linksObj,
        coverImage: p.coverImage,
      };
    }),
  },
};

const blogEs = await fetchSingleType<BlogPageAttributes>("blog-page", "es", {
  populate: "*",
});
const blogEn = await fetchSingleType<BlogPageAttributes>("blog-page", "en", {
  populate: "*",
});

if (!blogEs || !blogEn) {
  throw new Error("Failed to fetch blog-page from Strapi");
}

const blogPostsEs = await fetchCollection<BlogPostAttributes>(
  "blog-posts",
  "es",
  { populate: { category: true, coverImage: true } },
);
const blogPostsEn = await fetchCollection<BlogPostAttributes>(
  "blog-posts",
  "en",
  { populate: { category: true, coverImage: true } },
);

const blogData = {
  es: {
    title: blogEs.title,
    intro: blogEs.intro,
    view_more: blogEs.view_more,
    posts: (blogPostsEs ?? []).map((p) => ({
      id: p.documentId,
      title: p.title,
      link: `/blog/${p.slug}`,
      category: p.category?.name || "",
      date: p.date,
      read_time: calculateReadingTime(p.content, "es"),
      resume: p.excerpt,
      featuredImage: p.coverImage || undefined,
    })),
  },
  en: {
    title: blogEn.title,
    intro: blogEn.intro,
    view_more: blogEn.view_more,
    posts: (blogPostsEn ?? []).map((p) => ({
      id: p.documentId,
      title: p.title,
      link: `/blog/${p.slug}`,
      category: p.category?.name || "",
      date: p.date,
      read_time: calculateReadingTime(p.content, "en"),
      resume: p.excerpt,
      featuredImage: p.coverImage || undefined,
    })),
  },
};

const contactEs = await fetchSingleType<ContactPageAttributes>(
  "contact-page",
  "es",
  { populate: "*" },
);
const contactEn = await fetchSingleType<ContactPageAttributes>(
  "contact-page",
  "en",
  { populate: "*" },
);

if (!contactEs || !contactEn) {
  throw new Error("Failed to fetch contact-page from Strapi");
}

function normalizeMailTo(email: string): string {
  if (!email) return "#";
  if (email.startsWith("mailto:")) return email;
  return `mailto:${email}`;
}

const contactData = {
  es: {
    title: contactEs.title,
    statusMessage: contactEs.statusMessage,
    buttonText: contactEs.buttonText,
    mailTo: normalizeMailTo(contactEs.mailTo),
    footer: contactEs.footer,
  },
  en: {
    title: contactEn.title,
    statusMessage: contactEn.statusMessage,
    buttonText: contactEn.buttonText,
    mailTo: normalizeMailTo(contactEn.mailTo),
    footer: contactEn.footer,
  },
};
---

<MainLayout
  title={globalConfig.siteTitle}
  lang="es"
  description={globalConfig.siteDescription}
  navigation={globalConfig.navigation ?? []}
  social={globalConfig.social ?? []}
  defaultLocale={globalConfig.defaultLocale}
  seo={globalConfig.seo}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: globalConfig.siteName,
      alternateName: globalConfig.siteTitle,
      url: siteUrl,
      image: `${siteUrl}/favicon.ico`,
      jobTitle: "Software Engineer",
      sameAs,
    })}
  />
  <Home es={homeData.es} en={homeData.en} />
  <About es={aboutData.es} en={aboutData.en} />
  <Experience es={expData.es} en={expData.en} />
  <Portfolio es={portfolioData.es} en={portfolioData.en} />
  <Blog es={blogData.es} en={blogData.en} />
  <Contact es={contactData.es} en={contactData.en} />
</MainLayout>
