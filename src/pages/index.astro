---
import config from "../data/config.json";
import MainLayout from "../layouts/MainLayout.astro";
import Home from "../components/sections/Home.astro";
import About from "../components/sections/About.astro";
import Experience from "@components/sections/Experience.astro";
import Portfolio from "@components/sections/Portfolio.astro";
import Blog from "@components/sections/Blog.astro";
import Contact from "@components/sections/Contact.astro";
---

<MainLayout title={config.site.title}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: config.site.name,
      alternateName: config.site.title,
      url: config.site.url,
      image: `${config.site.url}/favicon.ico`,
      jobTitle: "Software Engineer",
      sameAs: [
        config.social.github,
        config.social.linkedin,
        config.social.instagram,
      ],
    })}
  />
  <Home />
  <About />
  <Experience />
  <Portfolio />
  <Blog />
  <Contact />
</MainLayout>
