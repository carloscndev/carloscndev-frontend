---
import { fetchSingleType } from "../services/strapi";
import type { GlobalConfigAttributes } from "../types/global-config";
import type { PortfolioPageAttributes } from "../types/portfolio-page";
import PostLayout from "../layouts/PostLayout.astro";
import Diamond from "../components/icons/Diamond.astro";
import TechPill from "../components/ui/TechPill.astro";
import GithubIcon from "../components/icons/GithubIcon.astro";
import ExternalLink from "../components/icons/ExternalLink.astro";
import FileIcon from "../components/icons/FileIcon.astro";
import LinkWrapper from "../components/ui/LinkWrapper.astro";

const globalConfig = await fetchSingleType<GlobalConfigAttributes>(
  "global-config",
  "es",
  { populate: ["navigation", "social"] },
);

if (!globalConfig) {
  throw new Error("Failed to fetch global-config from Strapi");
}

const portfolioEs = await fetchSingleType<PortfolioPageAttributes>(
  "portfolio-page",
  "es",
  { populate: "*" },
);
const portfolioEn = await fetchSingleType<PortfolioPageAttributes>(
  "portfolio-page",
  "en",
  { populate: "*" },
);

if (!portfolioEs || !portfolioEn) {
  throw new Error("Failed to fetch portfolio-page from Strapi");
}

const currentLang = "es";
const data = portfolioEs;

const embeddedData = {
  es: {
    title: portfolioEs.title,
    intro: portfolioEs.intro,
    view_more: portfolioEs.view_more,
    projects: (portfolioEs.projects ?? []).map((p) => ({
      id: p.id,
      title: p.title,
      description: p.description,
      technologies: p.technologies,
      links: {
        repo: p.links?.repo,
        demo: p.links?.demo,
        article: p.links?.article,
      },
    })),
  },
  en: {
    title: portfolioEn.title,
    intro: portfolioEn.intro,
    view_more: portfolioEn.view_more,
    projects: (portfolioEn.projects ?? []).map((p) => ({
      id: p.id,
      title: p.title,
      description: p.description,
      technologies: p.technologies,
      links: {
        repo: p.links?.repo,
        demo: p.links?.demo,
        article: p.links?.article,
      },
    })),
  },
};
const embeddedDataJson = JSON.stringify(embeddedData);
---

<PostLayout
  title="Portfolio — Projects"
  lang={currentLang}
  navigation={globalConfig.navigation ?? []}
  defaultLocale={globalConfig.defaultLocale}
>
  <script
    is:inline
    type="application/json"
    id="portfolio-data"
    set:html={embeddedDataJson}
  />

  <section class="projects-page">
    <header class="projects-page__header">
      <h1 class="projects-page__title">{data.title}</h1>
    </header>

    <div class="portfolio-grid">
      {
        (data.projects ?? []).map((project) => (
          <div class="portfolio-grid__card" data-project-id={project.id}>
            <div class="portfolio-card__header">
              <Diamond size="22" class="portfolio-card__diamond" />
              <div class="portfolio-card__links" data-project-links>
                {project.links?.repo && (
                  <LinkWrapper
                    href={project.links.repo}
                    class="portfolio-card__link"
                    aria-label="Repository"
                  >
                    <GithubIcon size="18" />
                  </LinkWrapper>
                )}
                {project.links?.demo && (
                  <LinkWrapper
                    href={project.links.demo}
                    class="portfolio-card__link"
                    aria-label="Demo"
                  >
                    <ExternalLink size="18" />
                  </LinkWrapper>
                )}
                {project.links?.article && (
                  <LinkWrapper
                    href={project.links.article}
                    class="portfolio-card__link"
                    aria-label="Article"
                  >
                    <FileIcon size="18" />
                  </LinkWrapper>
                )}
              </div>
            </div>
            <h3 class="portfolio-card__title" data-project-title>
              {project.title}
            </h3>
            <p class="portfolio-card__description" data-project-description>
              {project.description}
            </p>
            <div class="portfolio-card__tags" data-project-tags>
              {project.technologies.map((tech: string) => (
                <TechPill label={tech} variant="card" />
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="portfolio-accordion" data-portfolio-accordion>
      {
        (data.projects ?? []).map((project) => (
          <div
            class="portfolio-accordion__item"
            data-accordion-item
            data-project-id={project.id}
          >
            <button
              class="portfolio-accordion__trigger"
              data-accordion-trigger
              aria-expanded="false"
              type="button"
            >
              <Diamond size="22" class="portfolio-accordion__diamond" />
              <span class="portfolio-accordion__title" data-project-title>
                {project.title}
              </span>
              <svg
                class="portfolio-accordion__chevron"
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </button>
            <div class="portfolio-accordion__panel" data-accordion-panel>
              <p
                class="portfolio-accordion__description"
                data-project-description
              >
                {project.description}
              </p>
              <div class="portfolio-accordion__tags" data-project-tags>
                {project.technologies.map((tech: string) => (
                  <TechPill label={tech} variant="card" />
                ))}
              </div>
              <div class="portfolio-accordion__links" data-project-links>
                {project.links?.repo && (
                  <LinkWrapper
                    href={project.links.repo}
                    class="portfolio-accordion__link"
                    aria-label="Repository"
                  >
                    <GithubIcon size="16" />
                  </LinkWrapper>
                )}
                {project.links?.demo && (
                  <LinkWrapper
                    href={project.links.demo}
                    class="portfolio-accordion__link"
                    aria-label="Demo"
                  >
                    <ExternalLink size="16" />
                  </LinkWrapper>
                )}
                {project.links?.article && (
                  <LinkWrapper
                    href={project.links.article}
                    class="portfolio-accordion__link"
                    aria-label="Article"
                  >
                    <FileIcon size="16" />
                  </LinkWrapper>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</PostLayout>

<script>
  import {
    initPortfolioLangSwitch,
    initPortfolioAccordion,
  } from "../utils/portfolio.ts";
  initPortfolioLangSwitch();
  initPortfolioAccordion();
</script>

<style>
  .projects-page {
    width: 100%;
    max-width: 100%;
    padding: var(--spacing-xl) var(--spacing-lg);
  }

  .projects-page__header {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }

  .projects-page__title {
    font-family: var(--font-titles);
    font-size: var(--font-size-h2-mobile);
    font-weight: var(--weight-space-semibold);
    color: var(--text-base);
  }

  .portfolio-grid {
    display: none;
    gap: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    width: 100%;
    max-width: var(--max-width);
  }

  .portfolio-grid__card {
    border-radius: var(--border-radius);
    background: var(--color-tech-primary-light);
    padding: var(--spacing-md);
    transition:
      transform 300ms ease,
      box-shadow 300ms ease;
  }

  :global(.dark) .portfolio-grid__card {
    background: var(--color-tech-primary-dark);
  }

  .portfolio-grid__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  :global(.dark) .portfolio-grid__card:hover {
    box-shadow: var(--shadow-card-dark);
  }

  .portfolio-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-md);
  }

  .portfolio-card__links {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  :global(.portfolio-card__diamond) {
    color: var(--color-word);
  }

  :global(.portfolio-card__link) {
    color: var(--color-word);
    transition: color 300ms ease;
  }

  :global(.portfolio-card__link):hover,
  :global(.portfolio-card__link):focus-visible {
    color: var(--color-accent);
  }

  :global(.portfolio-card__link) svg,
  :global(.portfolio-card__link) path,
  :global(.portfolio-card__diamond) path {
    transition: none;
  }

  .portfolio-card__title {
    font-family: var(--font-titles);
    font-size: var(--font-size-h3-mobile);
    font-weight: var(--weight-space-semibold);
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .portfolio-card__description {
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    color: var(--text-base);
    line-height: 1.8;
    margin-bottom: 1rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .portfolio-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .portfolio-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    width: 100%;
  }

  .portfolio-accordion__item {
    border-radius: var(--border-radius);
    background: var(--color-tech-primary-light);
    overflow: hidden;
  }

  :global(.dark) .portfolio-accordion__item {
    background: var(--color-tech-primary-dark);
  }

  .portfolio-accordion__trigger {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    width: 100%;
    padding: var(--spacing-md);
    background: none;
    border: none;
    color: var(--text-base);
    font-family: var(--font-titles);
    font-size: var(--font-size-h3-mobile);
    font-weight: var(--weight-space-medium);
    cursor: pointer;
    text-align: left;
  }

  .portfolio-accordion__title {
    flex: 1;
    color: var(--color-accent);
  }

  :global(.portfolio-accordion__diamond) {
    color: var(--color-word);
    flex-shrink: 0;
  }

  :global(.portfolio-accordion__diamond) path {
    transition: none;
  }

  .portfolio-accordion__chevron {
    flex-shrink: 0;
    color: var(--color-word);
    transition: transform 300ms ease;
  }

  .portfolio-accordion__trigger[aria-expanded="true"]
    .portfolio-accordion__chevron {
    transform: rotate(180deg);
  }

  .portfolio-accordion__panel {
    max-height: 0;
    overflow: hidden;
    transition:
      max-height 350ms ease,
      padding 350ms ease;
    padding: 0 var(--spacing-md);
  }

  .portfolio-accordion__panel--open {
    max-height: 600px;
    padding: 1rem var(--spacing-md) var(--spacing-md);
  }

  .portfolio-accordion__description {
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    color: var(--text-base);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .portfolio-accordion__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .portfolio-accordion__links {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  :global(.portfolio-accordion__link) {
    color: var(--color-word);
    transition: color 300ms ease;
  }

  :global(.portfolio-accordion__link):hover,
  :global(.portfolio-accordion__link):focus-visible {
    color: var(--color-accent);
  }

  @media (min-width: 480px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
      display: grid;
    }

    .portfolio-accordion {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .projects-page {
      padding: var(--spacing-xl);
    }

    .projects-page__title {
      font-size: var(--font-size-h2-desktop);
    }

    .portfolio-grid {
      grid-template-columns: repeat(3, 1fr);
      display: grid;
    }

    .portfolio-accordion {
      display: none;
    }
  }
</style>
