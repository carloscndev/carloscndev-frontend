---
import {
  fetchCollection,
  fetchCollectionEntry,
  fetchSingleType,
  getStrapiMediaUrl,
} from "../../services/strapi";
import type { GlobalConfigAttributes } from "../../types/global-config";
import type { BlogPostAttributes } from "../../types/blog-post";
import PostLayout from "../../layouts/PostLayout.astro";
import StrapiImage from "../../components/ui/StrapiImage.astro";
import LinkWrapper from "../../components/ui/LinkWrapper.astro";
import ArrowNext from "../../components/icons/ArrowNext.astro";
import { Marked } from "marked";
import markedShiki from "marked-shiki";
import { createHighlighter } from "shiki";
import uiDict from "../../i18n/ui.json";
import type { Lang } from "../../utils/lang";
import { calculateReadingTime } from "../../utils/reading-time";

// 1. Initialize Shiki highlighter
const highlighter = await createHighlighter({
  themes: ["github-dark"],
  langs: [
    "javascript",
    "typescript",
    "css",
    "html",
    "bash",
    "json",
    "markdown",
  ],
});

// 2. Create a Marked instance with Shiki plugin
const marked = new Marked().use(
  markedShiki({
    highlight(code, lang) {
      const safeLang = lang === "mermaid" ? "text" : lang;

      return highlighter.codeToHtml(code, {
        lang: safeLang,
        theme: "github-dark",
      });
    },
  }),
);

export async function getStaticPaths() {
  let esPosts: BlogPostAttributes[] = [];
  let enPosts: BlogPostAttributes[] = [];

  try {
    esPosts = await fetchCollection<BlogPostAttributes>("blog-posts", "es", {
      populate: { category: true, coverImage: true },
    });
  } catch {
    // No ES posts found, continue with empty array
  }

  try {
    enPosts = await fetchCollection<BlogPostAttributes>("blog-posts", "en", {
      populate: { category: true, coverImage: true },
    });
  } catch {
    // No EN posts found, continue with empty array
  }

  if (esPosts.length === 0 && enPosts.length === 0) {
    return [];
  }

  const paths: Array<{
    params: { slug: string };
    props: { lang: Lang; documentId: string };
  }> = [];

  for (const post of esPosts) {
    try {
      const exists = await fetchCollectionEntry<BlogPostAttributes>(
        "blog-posts",
        post.documentId,
        "es",
      );
      if (exists) {
        paths.push({
          params: { slug: post.slug },
          props: { lang: "es", documentId: post.documentId },
        });
      }
    } catch {
      // Post not accessible in this locale, skip
    }
  }

  for (const post of enPosts) {
    try {
      const exists = await fetchCollectionEntry<BlogPostAttributes>(
        "blog-posts",
        post.documentId,
        "en",
      );
      if (exists) {
        paths.push({
          params: { slug: post.slug },
          props: { lang: "en", documentId: post.documentId },
        });
      }
    } catch {
      // Post not accessible in this locale, skip
    }
  }

  return paths;
}

const { lang, documentId } = Astro.props;

let post: BlogPostAttributes | null = null;
let fetchError: Error | null = null;

try {
  post = await fetchCollectionEntry<BlogPostAttributes>(
    "blog-posts",
    documentId,
    lang,
    {
      populate: {
        category: true,
        coverImage: true,
        seo: true,
        author: { populate: { avatar: true } },
      },
    },
  );
} catch (e) {
  fetchError = e instanceof Error ? e : new Error(String(e));
}

if (fetchError || !post) {
  return Astro.redirect("/");
}

const globalConfig = await fetchSingleType<GlobalConfigAttributes>(
  "global-config",
  lang,
  { populate: ["navigation", "social"] },
);

if (!globalConfig) {
  throw new Error("Failed to fetch global-config from Strapi");
}

// Parse Markdown content to HTML for both locales (await because marked-shiki uses async highlight)
const postContentHtml = (await marked.parse(post.content)) as string;

const authorName = post.author?.name || "";
const authorNickname = post.author?.nickname || "";
const authorAvatar = post.author?.avatar?.url
  ? getStrapiMediaUrl(post.author.avatar.url)
  : "";
const readTime = calculateReadingTime(post.content, lang);

// Fetch other locale post for client-side language switching
const otherLang = lang === "es" ? "en" : "es";
const otherPost = await fetchCollectionEntry<BlogPostAttributes>(
  "blog-posts",
  documentId,
  otherLang,
  {
    populate: {
      category: true,
      coverImage: true,
      author: { populate: { avatar: true } },
    },
  },
);

const otherContentHtml = otherPost
  ? ((await marked.parse(otherPost.content)) as string)
  : "";

const embeddedData = {
  es:
    lang === "es"
      ? {
          title: post.title,
          date: post.date,
          readTime: readTime,
          authorName: authorName,
          authorNickname: authorNickname,
          authorAvatar: authorAvatar,
          category: post.category?.name || "",
          content: postContentHtml,
        }
      : otherPost
        ? {
            title: otherPost.title,
            date: otherPost.date,
            readTime: calculateReadingTime(otherPost.content, "es"),
            authorName: otherPost.author?.name || "",
            authorNickname: otherPost.author?.nickname || "",
            authorAvatar: otherPost.author?.avatar?.url
              ? getStrapiMediaUrl(otherPost.author.avatar.url)
              : "",
            category: otherPost.category?.name || "",
            content: otherContentHtml,
          }
        : null,
  en:
    lang === "en"
      ? {
          title: post.title,
          date: post.date,
          readTime: readTime,
          authorName: authorName,
          authorNickname: authorNickname,
          authorAvatar: authorAvatar,
          category: post.category?.name || "",
          content: postContentHtml,
        }
      : otherPost
        ? {
            title: otherPost.title,
            date: otherPost.date,
            readTime: calculateReadingTime(otherPost.content, "en"),
            authorName: otherPost.author?.name || "",
            authorNickname: otherPost.author?.nickname || "",
            authorAvatar: otherPost.author?.avatar?.url
              ? getStrapiMediaUrl(otherPost.author.avatar.url)
              : "",
            category: otherPost.category?.name || "",
            content: otherContentHtml,
          }
        : null,
};

const blogPostDataJson = JSON.stringify(embeddedData);
const uiDictJson = JSON.stringify(uiDict);

const postSeo = post.seo
  ? {
      ...post.seo,
      metaImage: post.seo.metaImage?.url
        ? {
            ...post.seo.metaImage,
            url: getStrapiMediaUrl(post.seo.metaImage.url),
          }
        : post.coverImage?.url
          ? { ...post.coverImage, url: getStrapiMediaUrl(post.coverImage.url) }
          : undefined,
    }
  : undefined;
---

<PostLayout
  title={post.title}
  lang={lang}
  category={post.category?.name}
  navigation={globalConfig.navigation ?? []}
  defaultLocale={globalConfig.defaultLocale}
  seo={postSeo}
>
  <script
    is:inline
    type="application/json"
    id="blog-post-data"
    set:html={blogPostDataJson}
  />
  <script
    is:inline
    type="application/json"
    id="blog-post-dict"
    set:html={uiDictJson}
  />

  <div class="post-hero">
    {
      post.coverImage ? (
        <StrapiImage
          image={post.coverImage}
          alt=""
          class="post-hero__image"
          loading="lazy"
        />
      ) : (
        <div class="post-hero__image-placeholder" aria-hidden="true" />
      )
    }
    <div class="post-hero__overlay">
      <h1 class="post-hero__title" data-post-hero-title>
        {post.title}
      </h1>
    </div>
  </div>

  <div class="post-body">
    <div class="post-body__inner">
      <div class="post-body__meta" data-post-hero-meta>
        <div class="post-body__meta-left">
          <span class="post-body__meta-date" data-post-date>{post.date}</span>
          <span class="post-body__meta-readtime" data-post-readtime
            >{readTime}</span
          >
        </div>
        <div class="post-body__meta-right">
          <img
            src={authorAvatar}
            alt={authorName}
            class="post-body__meta-avatar"
            data-post-author-avatar
            style={authorAvatar ? "display: block" : "display: none"}
          />
          <div class="post-body__meta-author-info">
            <span class="post-body__meta-author-name" data-post-author-name
              >{authorName}</span
            >
            {
              authorNickname && (
                <span
                  class="post-body__meta-author-nickname"
                  data-post-author-nickname
                >
                  @{authorNickname}
                </span>
              )
            }
          </div>
        </div>
      </div>

      <div
        class="post-body__content"
        data-post-content
        set:html={postContentHtml}
      />

      <div class="post-body__back-home">
        <LinkWrapper
          href="/"
          isExternal={false}
          class="post-body__back-home-link"
          data-post-back-home
        >
          <ArrowNext size="18" class="post-body__back-home-icon" />
          <span>Volver al inicio</span>
        </LinkWrapper>
      </div>
    </div>
  </div>
</PostLayout>

<script>
  import { initBlogPostLangSwitch } from "../../utils/blog-post.ts";
  initBlogPostLangSwitch();
</script>

