---
import PostLayout from "../../layouts/post-layout.astro";
import blogPostData from "../../data/blog-post.json";

export function getStaticPaths() {
  const esPosts = blogPostData.es.posts;
  const enPosts = blogPostData.en.posts;

  const paths = [];

  esPosts.forEach((post) => {
    paths.push({
      params: { slug: post.id },
      props: { lang: "es", postId: post.id },
    });
  });

  enPosts.forEach((post) => {
    paths.push({
      params: { slug: post.id },
      props: { lang: "en", postId: post.id },
    });
  });

  return paths;
}

const { lang, postId } = Astro.props;
const data = blogPostData[lang];
const post = data.posts.find((p) => p.id === postId);

if (!post) {
  return Astro.redirect("/404");
}
---

<PostLayout title={post.title} lang={lang}>
  <div slot="header-image" class="header-image-placeholder">
    <span class="header-image-placeholder__text">Header Image</span>
  </div>

  <div class="post-meta">
    <span class="post-meta__date">{post.date}</span>
    <span class="post-meta__separator">·</span>
    <span class="post-meta__author">{post.author}</span>
  </div>

  <h1 class="post-title">{post.title}</h1>

  {
    post.content.map((block) => {
      if (block.type === "paragraph") {
        return <p>{block.text}</p>;
      }
      return null;
    })
  }
</PostLayout>

<style>
  .header-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header-image-placeholder__text {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.875rem;
    font-family: var(--font-body);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    color: var(--color-word);
  }

  .post-meta__separator {
    opacity: 0.5;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 2rem;
    color: var(--text-base);
  }

  @media (min-width: 768px) {
    .post-title {
      font-size: 3rem;
    }
  }
</style>

<script>
  const backButton = document.querySelector(".back-button");

  if (backButton) {
    backButton.addEventListener("click", () => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = "/";
      }
    });
  }
</script>
