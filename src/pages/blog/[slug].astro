---
import {
  fetchCollection,
  fetchCollectionEntry,
  fetchSingleType,
} from "../../services/strapi";
import type { GlobalConfigAttributes } from "../../types/global-config";
import type { BlogPostAttributes } from "../../types/blog-post";
import PostLayout from "../../layouts/PostLayout.astro";
import StrapiImage from "../../components/ui/StrapiImage.astro";
import LinkWrapper from "../../components/ui/LinkWrapper.astro";
import ArrowNext from "../../components/icons/ArrowNext.astro";
import { Marked } from "marked";
import markedShiki from "marked-shiki";
import { createHighlighter } from "shiki";
import uiDict from "../../i18n/ui.json";
import type { Lang } from "../../utils/lang";

// 1. Initialize Shiki highlighter
const highlighter = await createHighlighter({
  themes: ["github-dark"],
  langs: [
    "javascript",
    "typescript",
    "css",
    "html",
    "bash",
    "json",
    "markdown",
  ],
});

// 2. Create a Marked instance with Shiki plugin
const marked = new Marked().use(
  markedShiki({
    highlight(code, lang) {
      return highlighter.codeToHtml(code, { lang, theme: "github-dark" });
    },
  }),
);

export async function getStaticPaths() {
  const esPosts = await fetchCollection<BlogPostAttributes>(
    "blog-posts",
    "es",
    { populate: { category: true, headerImage: true } },
  );
  const enPosts = await fetchCollection<BlogPostAttributes>(
    "blog-posts",
    "en",
    { populate: { category: true, headerImage: true } },
  );

  const paths: Array<{
    params: { slug: string };
    props: { lang: Lang; documentId: string };
  }> = [];

  esPosts.forEach((post) => {
    paths.push({
      params: { slug: post.slug },
      props: { lang: "es", documentId: post.documentId },
    });
  });

  enPosts.forEach((post) => {
    paths.push({
      params: { slug: post.slug },
      props: { lang: "en", documentId: post.documentId },
    });
  });

  return paths;
}

const { lang, documentId } = Astro.props;

const post = await fetchCollectionEntry<BlogPostAttributes>(
  "blog-posts",
  documentId,
  lang,
  { populate: { category: true, headerImage: true } },
);

if (!post) {
  return Astro.redirect("/404");
}

const globalConfig = await fetchSingleType<GlobalConfigAttributes>(
  "global-config",
  lang,
  { populate: ["navigation", "social"] },
);

if (!globalConfig) {
  throw new Error("Failed to fetch global-config from Strapi");
}

// Parse Markdown content to HTML for both locales (await because marked-shiki uses async highlight)
const postContentHtml = (await marked.parse(post.content)) as string;

const categoryTheme = post.icon === "running-icon" ? "running" : "tech";
const authorPrefix = uiDict[lang]["post.author_prefix"];

// Fetch other locale post for client-side language switching
const otherLang = lang === "es" ? "en" : "es";
const otherPost = await fetchCollectionEntry<BlogPostAttributes>(
  "blog-posts",
  documentId,
  otherLang,
  { populate: { category: true, headerImage: true } },
);

const otherContentHtml = otherPost
  ? ((await marked.parse(otherPost.content)) as string)
  : "";

const embeddedData = {
  es:
    lang === "es"
      ? {
          title: post.title,
          date: post.date,
          author: post.author || "",
          category: post.category?.name || "",
          icon: post.icon,
          content: postContentHtml,
        }
      : otherPost
        ? {
            title: otherPost.title,
            date: otherPost.date,
            author: otherPost.author || "",
            category: otherPost.category?.name || "",
            icon: otherPost.icon,
            content: otherContentHtml,
          }
        : null,
  en:
    lang === "en"
      ? {
          title: post.title,
          date: post.date,
          author: post.author || "",
          category: post.category?.name || "",
          icon: post.icon,
          content: postContentHtml,
        }
      : otherPost
        ? {
            title: otherPost.title,
            date: otherPost.date,
            author: otherPost.author || "",
            category: otherPost.category?.name || "",
            icon: otherPost.icon,
            content: otherContentHtml,
          }
        : null,
};

const blogPostDataJson = JSON.stringify(embeddedData);
const uiDictJson = JSON.stringify(uiDict);
---

<PostLayout
  title={post.title}
  lang={lang}
  categoryTheme={categoryTheme}
  navigation={globalConfig.navigation ?? []}
  defaultLocale={globalConfig.defaultLocale}
>
  <script
    is:inline
    type="application/json"
    id="blog-post-data"
    set:html={blogPostDataJson}
  />
  <script
    is:inline
    type="application/json"
    id="blog-post-dict"
    set:html={uiDictJson}
  />

  <div class="post-hero">
    {
      post.headerImage ? (
        <StrapiImage
          image={post.headerImage}
          alt=""
          class="post-hero__image"
          loading="lazy"
        />
      ) : (
        <div class="post-hero__image-placeholder" aria-hidden="true" />
      )
    }
    <div class="post-hero__overlay">
      <h1 class="post-hero__title" data-post-hero-title>
        {post.title}
      </h1>
    </div>
  </div>

  <div class="post-body">
    <div class="post-body__inner">
      <p class="post-body__meta" data-post-hero-meta>
        {post.date} &nbsp;{authorPrefix}
        {post.author || ""}
      </p>

      <div
        class="post-body__content"
        data-post-content
        set:html={postContentHtml}
      />

      <div class="post-body__back-home">
        <LinkWrapper
          href="/"
          isExternal={false}
          class="post-body__back-home-link"
          data-post-back-home
        >
          <ArrowNext size="18" class="post-body__back-home-icon" />
          <span>Volver al inicio</span>
        </LinkWrapper>
      </div>
    </div>
  </div>
</PostLayout>

<script>
  import { initBlogPostLangSwitch } from "../../utils/blog-post.ts";
  initBlogPostLangSwitch();
</script>

<style>
  .post-hero {
    position: relative;
    width: 100%;
    height: 120px;
    overflow: hidden;
  }

  :global(.post-hero__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .post-hero__image-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    background: var(--color-word);
    opacity: 0.15;
  }

  .post-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(140, 136, 247, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-lg);
  }

  :global(html[data-category-theme="running"]) .post-hero__overlay {
    background: rgba(188, 219, 255, 0.85);
  }

  :global(html.dark[data-category-theme="tech"]) .post-hero__overlay {
    background: rgba(7, 3, 65, 0.85);
  }

  :global(html.dark[data-category-theme="running"]) .post-hero__overlay {
    background: rgba(0, 18, 33, 0.85);
  }

  .post-hero__title {
    font-family: var(--font-titles);
    font-size: 1.5rem;
    font-weight: var(--weight-space-semibold);
    color: var(--text-base);
    text-align: center;
    max-width: 700px;
    line-height: 1.3;
    text-shadow: var(--shadow-text);
  }

  .post-body {
    width: 100%;
    min-height: 50vh;
  }

  :global(html[data-category-theme="tech"]) {
    --wi-p1: var(--color-tech-secondary-light);
    --wi-p2: var(--color-tech-secondary-light);
    background: var(--color-tech-primary-light);
    scrollbar-color: var(--wi-p1) transparent;
  }

  :global(html[data-category-theme="running"]) {
    --wi-p1: var(--color-running-secondary-light);
    --wi-p2: var(--color-running-secondary-light);
    background: var(--color-running-primary-light);
    scrollbar-color: var(--wi-p1) transparent;
  }

  :global(html.dark[data-category-theme="tech"]) {
    --wi-p1: var(--color-tech-secondary-dark);
    --wi-p2: var(--color-tech-secondary-dark);
    background: var(--color-tech-primary-dark);
    scrollbar-color: var(--wi-p1) transparent;
  }

  :global(html.dark[data-category-theme="running"]) {
    --wi-p1: var(--color-running-secondary-dark);
    --wi-p2: var(--color-running-secondary-dark);
    background: var(--color-running-primary-dark);
    scrollbar-color: var(--wi-p1) transparent;
  }

  :global(html[data-category-theme="tech"]) ::-webkit-scrollbar-thumb {
    background-color: var(--color-tech-secondary-light);
    border-color: var(--color-tech-primary-light);
  }

  :global(html[data-category-theme="running"]) ::-webkit-scrollbar-thumb {
    background-color: var(--color-running-secondary-light);
    border-color: var(--color-running-primary-light);
  }

  :global(html.dark[data-category-theme="tech"]) ::-webkit-scrollbar-thumb {
    background-color: var(--color-tech-secondary-dark);
    border-color: var(--color-tech-primary-dark);
  }

  :global(html.dark[data-category-theme="running"]) ::-webkit-scrollbar-thumb {
    background-color: var(--color-running-secondary-dark);
    border-color: var(--color-running-primary-dark);
  }

  :global(html[data-category-theme]) ::-webkit-scrollbar-track {
    background: transparent;
  }

  :global(html[data-category-theme="tech"]) body {
    background: var(--color-tech-primary-light);
  }

  :global(html[data-category-theme="running"]) body {
    background: var(--color-running-primary-light);
  }

  :global(html.dark[data-category-theme="tech"]) body {
    background: var(--color-tech-primary-dark);
  }

  :global(html.dark[data-category-theme="running"]) body {
    background: var(--color-running-primary-dark);
  }

  .post-body__inner {
    max-width: 820px;
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-lg);
  }

  .post-body__meta {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-style: italic;
    color: var(--color-word);
    margin-bottom: var(--spacing-xl);
  }

  :global(html[data-category-theme="tech"]) .post-body__meta {
    color: var(--color-tech-secondary-light);
  }

  :global(html[data-category-theme="running"]) .post-body__meta {
    color: var(--color-running-secondary-light);
  }

  :global(html.dark[data-category-theme="tech"]) .post-body__meta {
    color: var(--color-tech-secondary-dark);
  }

  :global(html.dark[data-category-theme="running"]) .post-body__meta {
    color: var(--color-running-secondary-dark);
  }

  .post-body__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md-lg);
  }

  /* Markdown rendered content styles */
  .post-body__content :global(p) {
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    color: var(--text-base);
    line-height: 1.8;
  }

  .post-body__content :global(h1),
  .post-body__content :global(h2),
  .post-body__content :global(h3),
  .post-body__content :global(h4),
  .post-body__content :global(h5),
  .post-body__content :global(h6) {
    font-family: var(--font-titles);
    color: var(--text-base);
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-md);
  }

  .post-body__content :global(h1) {
    font-size: 1.75rem;
  }

  .post-body__content :global(h2) {
    font-size: 1.5rem;
  }

  .post-body__content :global(h3) {
    font-size: 1.25rem;
  }

  .post-body__content :global(ul),
  .post-body__content :global(ol) {
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    color: var(--text-base);
    line-height: 1.8;
    padding-left: var(--spacing-lg);
    margin-bottom: var(--spacing-md);
  }

  .post-body__content :global(li) {
    margin-bottom: var(--spacing-xs);
  }

  .post-body__content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    transition: opacity 200ms ease;
  }

  .post-body__content :global(a:hover) {
    opacity: 0.8;
  }

  .post-body__content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--spacing-md);
    margin: var(--spacing-md) 0;
    font-style: italic;
    color: var(--color-word);
  }

  .post-body__content :global(pre) {
    background: var(--color-bg-code, #1e1e1e);
    border-radius: 8px;
    padding: var(--spacing-md);
    overflow-x: auto;
    margin: var(--spacing-md) 0;
  }

  .post-body__content :global(code) {
    font-family: "Fira Code", "Consolas", monospace;
    font-size: 0.9em;
    background: var(--color-bg-code-inline, rgba(140, 136, 247, 0.1));
    padding: 0.15em 0.4em;
    border-radius: 4px;
    color: var(--text-base);
  }

  .post-body__content :global(pre code) {
    background: transparent;
    padding: 0;
    border-radius: 0;
    color: var(--color-code, #d4d4d4);
  }

  .post-body__content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-word);
    opacity: 0.3;
    margin: var(--spacing-xl) 0;
  }

  .post-body__content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--spacing-md) 0;
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
  }

  .post-body__content :global(th),
  .post-body__content :global(td) {
    border: 1px solid var(--color-word);
    padding: var(--spacing-xs) var(--spacing-sm);
    text-align: left;
  }

  .post-body__content :global(th) {
    background: rgba(140, 136, 247, 0.1);
    font-weight: var(--weight-space-semibold);
  }

  .post-body__content :global(strong) {
    font-weight: var(--weight-space-semibold);
  }

  .post-body__content :global(em) {
    font-style: italic;
  }

  @media (min-width: 768px) {
    .post-hero {
      height: 250px;
    }

    .post-hero__title {
      font-size: 2.25rem;
    }

    .post-body__inner {
      padding: var(--spacing-xl);
    }

    .post-body__meta {
      font-size: 0.875rem;
    }

    .post-body__content {
      gap: var(--spacing-lg);
    }

    .post-body__content :global(p),
    .post-body__content :global(ul),
    .post-body__content :global(ol),
    .post-body__content :global(table) {
      font-size: var(--font-size-body-desktop);
    }
  }

  /* Shiki syntax highlighted code blocks */
  .post-body__content :global(pre.shiki) {
    padding: 1.25rem;
    border-radius: 0.5rem;
    font-family: "Fira Code", "Courier New", Courier, monospace;
    font-size: 0.9rem;
    overflow-x: auto;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    margin: var(--spacing-md) 0;
  }

  /* Inline code (not inside pre) */
  .post-body__content :global(code:not(pre code)) {
    background-color: rgba(140, 136, 247, 0.15);
    color: var(--color-accent);
    padding: 0.15em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.85em;
    font-family: "Fira Code", "Courier New", Courier, monospace;
  }

  .post-body__back-home {
    margin-top: var(--spacing-xl);
    text-align: center;
  }

  .post-body__back-home-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-family: var(--font-titles);
    font-size: 1rem;
    color: var(--color-accent);
    transition: color 300ms ease;
  }

  .post-body__back-home-link:hover {
    color: var(--color-word);
  }

  .post-body__back-home-icon {
    transform: rotate(180deg);
    transition: transform 300ms ease;
  }

  .post-body__back-home-link:hover .post-body__back-home-icon {
    transform: rotate(180deg) translateX(-4px);
  }
</style>
