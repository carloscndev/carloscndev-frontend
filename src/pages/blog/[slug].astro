---
import {
  fetchCollection,
  fetchCollectionEntry,
  fetchSingleType,
} from "../../services/strapi";
import type { GlobalConfigAttributes } from "../../types/global-config";
import type { BlogPostAttributes } from "../../types/blog-post";
import PostLayout from "../../layouts/PostLayout.astro";
import { Image } from "astro:assets";
import wallperImage from "../../assets/images/wallper.jpg";
import uiDict from "../../i18n/ui.json";
import type { Lang } from "../../utils/lang";

export async function getStaticPaths() {
  const esPosts = await fetchCollection<BlogPostAttributes>(
    "blog-posts",
    "es",
    { populate: ["category"] },
  );
  const enPosts = await fetchCollection<BlogPostAttributes>(
    "blog-posts",
    "en",
    { populate: ["category"] },
  );

  const paths: Array<{
    params: { slug: string };
    props: { lang: Lang; documentId: string };
  }> = [];

  esPosts.forEach((post) => {
    paths.push({
      params: { slug: post.slug },
      props: { lang: "es", documentId: post.documentId },
    });
  });

  enPosts.forEach((post) => {
    paths.push({
      params: { slug: post.slug },
      props: { lang: "en", documentId: post.documentId },
    });
  });

  return paths;
}

const { lang, documentId } = Astro.props;

const post = await fetchCollectionEntry<BlogPostAttributes>(
  "blog-posts",
  documentId,
  lang,
  { populate: ["category"] },
);

if (!post) {
  return Astro.redirect("/404");
}

const globalConfig = await fetchSingleType<GlobalConfigAttributes>(
  "global-config",
  lang,
  { populate: ["navigation", "social"] },
);

if (!globalConfig) {
  throw new Error("Failed to fetch global-config from Strapi");
}

const categoryTheme = post.icon === "running-icon" ? "running" : "tech";
const authorPrefix = uiDict[lang]["post.author_prefix"];

// Fetch other locale post for client-side language switching
const otherLang = lang === "es" ? "en" : "es";
const otherPost = await fetchCollectionEntry<BlogPostAttributes>(
  "blog-posts",
  documentId,
  otherLang,
  { populate: ["category"] },
);

const embeddedData = {
  es:
    lang === "es"
      ? {
          title: post.title,
          date: post.date,
          author: post.author || "",
          category: post.category?.name || "",
          icon: post.icon,
          content: post.content,
        }
      : otherPost
        ? {
            title: otherPost.title,
            date: otherPost.date,
            author: otherPost.author || "",
            category: otherPost.category?.name || "",
            icon: otherPost.icon,
            content: otherPost.content,
          }
        : null,
  en:
    lang === "en"
      ? {
          title: post.title,
          date: post.date,
          author: post.author || "",
          category: post.category?.name || "",
          icon: post.icon,
          content: post.content,
        }
      : otherPost
        ? {
            title: otherPost.title,
            date: otherPost.date,
            author: otherPost.author || "",
            category: otherPost.category?.name || "",
            icon: otherPost.icon,
            content: otherPost.content,
          }
        : null,
};

const blogPostDataJson = JSON.stringify(embeddedData);
const uiDictJson = JSON.stringify(uiDict);
---

<PostLayout
  title={post.title}
  lang={lang}
  categoryTheme={categoryTheme}
  navigation={globalConfig.navigation ?? []}
  defaultLocale={globalConfig.defaultLocale}
>
  <script
    is:inline
    type="application/json"
    id="blog-post-data"
    set:html={blogPostDataJson}
  />
  <script
    is:inline
    type="application/json"
    id="blog-post-dict"
    set:html={uiDictJson}
  />

  <div class="post-hero">
    <Image
      src={wallperImage}
      alt=""
      class="post-hero__image"
      aria-hidden="true"
      loading="lazy"
    />
    <div class="post-hero__overlay">
      <h1 class="post-hero__title" data-post-hero-title>
        {post.title}
      </h1>
    </div>
  </div>

  <div class="post-body">
    <div class="post-body__inner">
      <p class="post-body__meta" data-post-hero-meta>
        {post.date} &nbsp;{authorPrefix}
        {post.author || ""}
      </p>

      <div
        class="post-body__content"
        data-post-content
        set:html={post.content}
      />
    </div>
  </div>
</PostLayout>

<script>
  import { initBlogPostLangSwitch } from "../../utils/blog-post.ts";
  initBlogPostLangSwitch();
</script>

<style>
  .post-hero {
    position: relative;
    width: 100%;
    height: 120px;
    overflow: hidden;
  }

  .post-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(140, 136, 247, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-lg);
  }

  :global(html[data-category-theme="running"]) .post-hero__overlay {
    background: rgba(188, 219, 255, 0.85);
  }

  :global(html.dark[data-category-theme="tech"]) .post-hero__overlay {
    background: rgba(7, 3, 65, 0.85);
  }

  :global(html.dark[data-category-theme="running"]) .post-hero__overlay {
    background: rgba(0, 18, 33, 0.85);
  }

  .post-hero__title {
    font-family: var(--font-titles);
    font-size: 1.5rem;
    font-weight: var(--weight-space-semibold);
    color: var(--text-base);
    text-align: center;
    max-width: 700px;
    line-height: 1.3;
    text-shadow: var(--shadow-text);
  }

  .post-body {
    width: 100%;
    min-height: 50vh;
  }

  :global(html[data-category-theme="tech"]) {
    --wi-p1: var(--color-tech-secondary-light);
    --wi-p2: var(--color-tech-secondary-light);
    background: var(--color-tech-primary-light);
    scrollbar-color: var(--wi-p1) transparent;
  }

  :global(html[data-category-theme="running"]) {
    --wi-p1: var(--color-running-secondary-light);
    --wi-p2: var(--color-running-secondary-light);
    background: var(--color-running-primary-light);
    scrollbar-color: var(--wi-p1) transparent;
  }

  :global(html.dark[data-category-theme="tech"]) {
    --wi-p1: var(--color-tech-secondary-dark);
    --wi-p2: var(--color-tech-secondary-dark);
    background: var(--color-tech-primary-dark);
    scrollbar-color: var(--wi-p1) transparent;
  }

  :global(html.dark[data-category-theme="running"]) {
    --wi-p1: var(--color-running-secondary-dark);
    --wi-p2: var(--color-running-secondary-dark);
    background: var(--color-running-primary-dark);
    scrollbar-color: var(--wi-p1) transparent;
  }

  :global(html[data-category-theme="tech"]) ::-webkit-scrollbar-thumb {
    background-color: var(--color-tech-secondary-light);
    border-color: var(--color-tech-primary-light);
  }

  :global(html[data-category-theme="running"]) ::-webkit-scrollbar-thumb {
    background-color: var(--color-running-secondary-light);
    border-color: var(--color-running-primary-light);
  }

  :global(html.dark[data-category-theme="tech"]) ::-webkit-scrollbar-thumb {
    background-color: var(--color-tech-secondary-dark);
    border-color: var(--color-tech-primary-dark);
  }

  :global(html.dark[data-category-theme="running"]) ::-webkit-scrollbar-thumb {
    background-color: var(--color-running-secondary-dark);
    border-color: var(--color-running-primary-dark);
  }

  :global(html[data-category-theme]) ::-webkit-scrollbar-track {
    background: transparent;
  }

  :global(html[data-category-theme="tech"]) body {
    background: var(--color-tech-primary-light);
  }

  :global(html[data-category-theme="running"]) body {
    background: var(--color-running-primary-light);
  }

  :global(html.dark[data-category-theme="tech"]) body {
    background: var(--color-tech-primary-dark);
  }

  :global(html.dark[data-category-theme="running"]) body {
    background: var(--color-running-primary-dark);
  }

  .post-body__inner {
    max-width: 820px;
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-lg);
  }

  .post-body__meta {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-style: italic;
    color: var(--color-word);
    margin-bottom: var(--spacing-xl);
  }

  :global(html[data-category-theme="tech"]) .post-body__meta {
    color: var(--color-tech-secondary-light);
  }

  :global(html[data-category-theme="running"]) .post-body__meta {
    color: var(--color-running-secondary-light);
  }

  :global(html.dark[data-category-theme="tech"]) .post-body__meta {
    color: var(--color-tech-secondary-dark);
  }

  :global(html.dark[data-category-theme="running"]) .post-body__meta {
    color: var(--color-running-secondary-dark);
  }

  .post-body__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md-lg);
  }

  .post-body__content :global(p) {
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    color: var(--text-base);
    line-height: 1.8;
  }

  @media (min-width: 768px) {
    .post-hero {
      height: 250px;
    }

    .post-hero__title {
      font-size: 2.25rem;
    }

    .post-body__inner {
      padding: var(--spacing-xl);
    }

    .post-body__meta {
      font-size: 0.875rem;
    }

    .post-body__content {
      gap: var(--spacing-lg);
    }

    .post-body__content :global(p) {
      font-size: var(--font-size-body-desktop);
    }
  }
</style>
