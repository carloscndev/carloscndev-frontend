---
import PostLayout from "../layouts/PostLayout.astro";
import LinkWrapper from "../components/ui/LinkWrapper.astro";
import ArrowNext from "../components/icons/ArrowNext.astro";
import { Image } from "astro:assets";
import sleepingImage from "../assets/images/slepping.png";
import errorData from "../data/404.json";

const lang = "es";
const data = errorData[lang].error_404;
const errorDataJson = JSON.stringify(errorData);
---

<PostLayout title="404 — Not Found" lang={lang} noindex>
  <script
    type="application/json"
    id="error-404-data"
    set:html={errorDataJson}
  />

  <div class="not-found">
    <div class="not-found__illustration">
      <Image
        src={sleepingImage}
        alt="Sleeping character illustration"
        class="not-found__image"
      />
    </div>

    <div class="not-found__content">
      <h1 class="not-found__title" data-404-title>{data.title}</h1>
      <p class="not-found__message" data-404-message>{data.message}</p>
      <LinkWrapper
        href="/"
        isExternal={false}
        class="not-found__button"
        data-404-button
      >
        <span>{data.button_text}</span>
        <ArrowNext size="18" />
      </LinkWrapper>
    </div>
  </div>
</PostLayout>

<script>
  import { init404LangSwitch } from "../utils/404.ts";
  init404LangSwitch();
</script>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--header-desktop-height));
    padding: var(--spacing-xl) var(--spacing-lg);
    text-align: center;
    gap: var(--spacing-lg);
  }

  .not-found__illustration {
    max-width: 280px;
    width: 100%;
  }

  .not-found__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .not-found__title {
    font-family: var(--font-titles);
    font-size: 1.5rem;
    font-weight: var(--weight-space-semibold);
    color: var(--text-base);
    line-height: 1.3;
    max-width: 480px;
  }

  .not-found__message {
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    color: var(--text-base);
    line-height: 1.8;
    max-width: 480px;
  }

  .not-found__button {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-family: var(--font-titles);
    font-size: 1rem;
    color: var(--color-accent);
    margin-top: var(--spacing-md);
    transition: color 300ms ease;
  }

  .not-found__button:hover {
    color: var(--color-word);
  }

  @media (min-width: 768px) {
    .not-found {
      flex-direction: row;
      text-align: left;
      padding: 0 60px;
      gap: var(--spacing-xl);
    }

    .not-found__illustration {
      max-width: 340px;
      flex-shrink: 0;
    }

    .not-found__title {
      font-size: var(--font-size-h2-desktop);
    }

    .not-found__message {
      font-size: var(--font-size-body-desktop);
    }
  }
</style>
