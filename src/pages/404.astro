---
import { fetchSingleType } from "../services/strapi";
import type { GlobalConfigAttributes } from "../types/global-config";
import type { ErrorPageAttributes } from "../types/error-page";
import PostLayout from "../layouts/PostLayout.astro";
import LinkWrapper from "../components/ui/LinkWrapper.astro";
import ArrowNext from "../components/icons/ArrowNext.astro";
import { Image } from "astro:assets";
import sleepingImage from "../assets/images/slepping.webp";

const globalConfig = await fetchSingleType<GlobalConfigAttributes>(
  "global-config",
  "es",
  { populate: ["navigation", "social"] },
);

if (!globalConfig) {
  throw new Error("Failed to fetch global-config from Strapi");
}

const errorEs = await fetchSingleType<ErrorPageAttributes>("error-page", "es", {
  populate: "*",
});
const errorEn = await fetchSingleType<ErrorPageAttributes>("error-page", "en", {
  populate: "*",
});

if (!errorEs || !errorEn) {
  throw new Error("Failed to fetch error-page from Strapi");
}

const lang = "es";

const embeddedData = {
  es: {
    title: errorEs.title,
    message: errorEs.message,
    button_text: errorEs.button_text,
  },
  en: {
    title: errorEn.title,
    message: errorEn.message,
    button_text: errorEn.button_text,
  },
};

const data = embeddedData[lang];
const errorDataJson = JSON.stringify(embeddedData);
---

<PostLayout
  title="404 — Not Found"
  lang={lang}
  noindex
  navigation={globalConfig.navigation ?? []}
  defaultLocale={globalConfig.defaultLocale}
>
  <script
    is:inline
    type="application/json"
    id="error-404-data"
    set:html={errorDataJson}
  />

  <div class="not-found">
    <div class="not-found__illustration">
      <Image
        src={sleepingImage}
        alt="Sleeping character illustration"
        class="not-found__image"
        loading="lazy"
        widths={[300, 400, 800, sleepingImage.width]}
        sizes="(max-width: 767px) 280px, 340px"
        format="webp"
      />
    </div>

    <div class="not-found__content">
      <h1 class="not-found__title" data-404-title>{data.title}</h1>
      <p class="not-found__message" data-404-message>{data.message}</p>
      <LinkWrapper
        href="/"
        isExternal={false}
        class="not-found__button"
        data-404-button
      >
        <span>{data.button_text}</span>
        <ArrowNext size="18" />
      </LinkWrapper>
    </div>
  </div>
</PostLayout>

<script>
  import { init404LangSwitch } from "../utils/404.ts";
  init404LangSwitch();
</script>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--header-desktop-height));
    padding: var(--spacing-xl) var(--spacing-lg);
    text-align: center;
    gap: var(--spacing-lg);
  }

  .not-found__illustration {
    max-width: 280px;
    width: 100%;
  }

  .not-found__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .not-found__title {
    font-family: var(--font-titles);
    font-size: 1.5rem;
    font-weight: var(--weight-space-semibold);
    color: var(--text-base);
    line-height: 1.3;
    max-width: 480px;
  }

  .not-found__message {
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    color: var(--text-base);
    line-height: 1.8;
    max-width: 480px;
  }

  .not-found__button {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-family: var(--font-titles);
    font-size: 1rem;
    color: var(--color-accent);
    margin-top: var(--spacing-md);
    transition: color 300ms ease;
  }

  .not-found__button:hover {
    color: var(--color-word);
  }

  @media (min-width: 768px) {
    .not-found {
      flex-direction: row;
      text-align: left;
      padding: 0 60px;
      gap: var(--spacing-xl);
    }

    .not-found__illustration {
      max-width: 340px;
      flex-shrink: 0;
    }

    .not-found__title {
      font-size: var(--font-size-h2-desktop);
    }

    .not-found__message {
      font-size: var(--font-size-body-desktop);
    }
  }
</style>
