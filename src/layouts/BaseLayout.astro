---
import { ClientRouter } from "astro:transitions";
import { getPreferredTheme, applyTheme } from "@utils/theme";
import Analytics from "@vercel/analytics/astro";
import BaseSEO from "@components/BaseSEO.astro";
import "../styles/global.css";

interface Props {
  title: string;
  lang?: "es" | "en";
  description?: string;
  image?: string;
  keywords?: string;
  metaRobots?: string;
  category?: string;
}

const {
  title,
  lang = "es",
  description = "Carlos Castañeda — Software Engineer. Portfolio, blog, and projects.",
  image,
  keywords,
  metaRobots,
  category,
} = Astro.props;

const canonicalUrl = `${Astro.site?.origin ?? "https://carloscndev.com"}${Astro.url.pathname}`;

const inlineThemeScript = `
  const STORAGE_KEY = "carloscndev-theme";
  const DARK = "dark";
  const LIGHT = "light";

  const apply = ${applyTheme.toString()};
  const getPreferred = ${getPreferredTheme.toString()};
  
  function getStoredTheme() {
    if (typeof localStorage === 'undefined') return null;
    const stored = localStorage.getItem(STORAGE_KEY);
    return (stored === DARK || stored === LIGHT) ? stored : null;
  }

  function initLayoutTheme() {
    const theme = getStoredTheme() || (window.matchMedia("(prefers-color-scheme: dark)").matches ? DARK : LIGHT);
    if (theme === DARK) {
      document.documentElement.classList.add(DARK);
    } else {
      document.documentElement.classList.remove(DARK);
    }
  }

  initLayoutTheme();

  // Pre-apply theme to the incoming document BEFORE it becomes visible
  // to prevent any flash of the wrong theme during ClientRouter navigation.
  document.addEventListener("astro:before-swap", (event) => {
    if (event.newDocument) {
      const theme = getStoredTheme() || (window.matchMedia("(prefers-color-scheme: dark)").matches ? DARK : LIGHT);
      if (theme === DARK) {
        event.newDocument.documentElement.classList.add(DARK);
      } else {
        event.newDocument.documentElement.classList.remove(DARK);
      }
    }
  });

  // Fallback: also re-apply after swap in case before-swap missed
  document.addEventListener("astro:after-swap", initLayoutTheme);
`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <BaseSEO
      title={title}
      description={description}
      image={image}
      keywords={keywords}
      metaRobots={metaRobots}
      category={category}
    />
    <ClientRouter />

    <script is:inline set:html={inlineThemeScript} />
    <script is:inline>
      // Sync category-theme meta tag to html[data-category-theme] after every swap
      // because ClientRouter does not replace the <html> element.
      function syncCategoryTheme() {
        const meta = document.querySelector('meta[name="category-theme"]');
        const theme = meta ? meta.getAttribute("content") : "";
        if (theme) {
          document.documentElement.dataset.categoryTheme = theme;
        } else {
          delete document.documentElement.dataset.categoryTheme;
        }
      }
      syncCategoryTheme();
      document.addEventListener("astro:after-swap", syncCategoryTheme);
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <Analytics />
  </body>
</html>

<style>
  body {
    align-items: start;
    display: flex;
    flex-direction: column;
    margin: auto;
    max-width: var(--max-width);
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--spacing-md);
    background: var(--color-accent);
    color: #fff;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--border-radius);
    z-index: 200;
    font-family: var(--font-body);
    transition: top 200ms ease;
  }

  .skip-link:focus {
    top: var(--spacing-sm);
  }
</style>
