---
import { ClientRouter } from "astro:transitions";
import { getPreferredTheme, applyTheme } from "@utils/theme";
import BaseSEO from "@components/BaseSEO.astro";
import config from "../data/config.json";
import "../styles/global.css";

interface Props {
  title: string;
  lang?: "es" | "en";
  description?: string;
  categoryTheme?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  lang = "es",
  description = config.site.description,
  categoryTheme,
  image,
  noindex,
} = Astro.props;

const inlineThemeScript = `
  const STORAGE_KEY = "carloscndev-theme";
  const DARK = "dark";
  const LIGHT = "light";

  const apply = ${applyTheme.toString()};
  const getPreferred = ${getPreferredTheme.toString()};
  
  function getStoredTheme() {
    if (typeof localStorage === 'undefined') return null;
    const stored = localStorage.getItem(STORAGE_KEY);
    return (stored === DARK || stored === LIGHT) ? stored : null;
  }

  function initLayoutTheme() {
    const theme = getStoredTheme() || (window.matchMedia("(prefers-color-scheme: dark)").matches ? DARK : LIGHT);
    if (theme === DARK) {
      document.documentElement.classList.add(DARK);
    } else {
      document.documentElement.classList.remove(DARK);
    }
  }

  initLayoutTheme();
  document.addEventListener("astro:after-swap", initLayoutTheme);
`;
---

<!doctype html>
<html lang={lang} data-category-theme={categoryTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={`${config.site.url}${Astro.url.pathname}`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, follow" />}
    <BaseSEO title={title} description={description} image={image} />
    <ClientRouter />

    <script is:inline set:html={inlineThemeScript} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>

<style>
  body {
    align-items: start;
    display: flex;
    flex-direction: column;
    margin: auto;
    max-width: var(--max-width);
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--spacing-md);
    background: var(--color-accent);
    color: #fff;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--border-radius);
    z-index: 200;
    font-family: var(--font-body);
    transition: top 200ms ease;
  }

  .skip-link:focus {
    top: var(--spacing-sm);
  }
</style>
