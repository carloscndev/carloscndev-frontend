---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/ui/Header.astro";
import SocialSidebar from "../components/ui/SocialSidebar.astro";

const { title, lang } = Astro.props;
---

<BaseLayout title={title} lang={lang}>
  <Header lang={lang} />
  <main class="main-content">
    <SocialSidebar />
    <article>
      <slot />
    </article>
  </main>
</BaseLayout>

<script>
  import { initAnchorRouting } from "../utils/anchor-routing";
  initAnchorRouting();
</script>

<style>
  .main-content {
    height: calc(100vh - var(--header-desktop-height));
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    width: 100%;
    -ms-overflow-style: none;
    display: grid;
    grid-template-columns: 1fr;
    margin: 0 auto;
    grid-template-areas:
      "main-section"
      "social-sidebar";

    &::-webkit-scrollbar {
      display: none;
    }
    article {
      grid-area: main-section;
    }

    section {
      align-items: center;
      display: flex;
      flex-direction: column;
      height: 100vh;
      justify-content: center;
      scroll-snap-align: center;
      scroll-snap-stop: always;
      width: 100%;
    }
    aside {
      grid-area: social-sidebar;
    }
  }

  @media (min-width: 768px) {
    .main-content {
      grid-template-areas: "social-sidebar main-section";
      grid-template-columns: auto 1fr;

      article {
        padding: 0 60px;
      }
    }
  }
</style>
