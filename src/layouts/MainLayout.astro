---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/ui/Header.astro";
import SocialSidebar from "../components/ui/SocialSidebar.astro";
import type {
  NavigationItem,
  SocialLink,
  GlobalConfigSeo,
} from "../types/global-config";

interface Props {
  title: string;
  lang?: "es" | "en";
  description?: string;
  navigation: NavigationItem[];
  social: SocialLink[];
  defaultLocale?: string;
  seo?: GlobalConfigSeo;
}

const { title, lang, description, navigation, social, defaultLocale, seo } =
  Astro.props;
---

<BaseLayout title={title} lang={lang} description={description} seo={seo}>
  <Header lang={lang} navigation={navigation} defaultLocale={defaultLocale} />
  <main id="main" class="main-content">
    <SocialSidebar social={social} />
    <article>
      <slot />
    </article>
  </main>
</BaseLayout>

<script>
  import { initAnchorRouting } from "../utils/anchor-routing";
  initAnchorRouting();
</script>

<style>
  .main-content {
    height: calc(100vh - var(--header-desktop-height));
    overflow-y: auto;
    overflow-x: hidden;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    width: 100%;
    -ms-overflow-style: none;
    display: grid;
    grid-template-columns: 1fr;
    margin: 0 auto;
    grid-template-areas:
      "main-section"
      "social-sidebar";

    &::-webkit-scrollbar {
      display: none;
    }
    article {
      grid-area: main-section;
    }

    section {
      align-items: center;
      display: flex;
      flex-direction: column;
      height: 100vh;
      justify-content: center;
      scroll-snap-align: center;
      scroll-snap-stop: always;
      width: 100%;
    }
    aside {
      grid-area: social-sidebar;
    }
  }

  @media (min-width: 768px) {
    .main-content {
      grid-template-areas: "social-sidebar main-section";
      grid-template-columns: auto 1fr;

      article {
        padding: 0 60px;
      }
    }
  }

  @media (max-width: 1023px) and (orientation: landscape) {
    :global(section) {
      height: auto;
      min-height: 100vh;
      padding: var(--spacing-sm);
    }

    :global(.home-section__grid),
    :global(.about-section__grid) {
      gap: var(--spacing-sm);
    }

    :global(.home-section__title),
    :global(.home-section__subtitle),
    :global(.home-section__subtitle strong) {
      font-size: 1.5rem !important;
    }

    :global(.social-sidebar) {
      margin-left: var(--spacing-md) !important;
    }

    :global(.social-sidebar-line) {
      display: none !important;
    }

    :global(.social-sidebar-list-item svg) {
      width: 16px;
      height: 16px;
    }

    :global(.social-sidebar-list-item) {
      padding: var(--spacing-xs) !important;
    }

    :global(.social-sidebar-list) {
      gap: var(--spacing-xs);
    }
  }
</style>
