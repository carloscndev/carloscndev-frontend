---
import GithubIcon from "@components/icons/GithubIcon.astro";
import InstagramIcon from "@components/icons/InstagramIcon.astro";
import LinkedInIcon from "@components/icons/LinkedInIcon.astro";
import MailIcon from "@components/icons/MailIcon.astro";
import CVIcon from "@components/icons/CV.astro";
import LinkWrapper from "./LinkWrapper.astro";
import type { SocialLink } from "../../types/global-config";

interface Props {
  social: SocialLink[];
}

const { social } = Astro.props;

const iconMap: Record<string, typeof GithubIcon> = {
  github: GithubIcon,
  instagram: InstagramIcon,
  linkedin: LinkedInIcon,
  email: MailIcon,
  cv: CVIcon,
};

const labelMap: Record<string, string> = {
  github: "GitHub",
  instagram: "Instagram",
  linkedin: "LinkedIn",
  email: "Email",
  cv: "Resume",
};
---

<aside class="social-sidebar">
  <ul class="social-sidebar-list" role="list">
    {
      social.map((link) => {
        const Icon = iconMap[link.platform] ?? GithubIcon;
        const label = labelMap[link.platform] ?? link.platform;
        const isExternal = !link.url.startsWith("mailto:");
        return (
          <li class="social-sidebar-list-item">
            <LinkWrapper
              href={link.url}
              isExternal={isExternal}
              tooltip={label}
            >
              <Icon />
            </LinkWrapper>
          </li>
        );
      })
    }
  </ul>
  <div class="social-sidebar-line"></div>
</aside>

<style>
  .social-sidebar {
    display: block;
    margin: auto;
    width: 60%;
    margin-bottom: 1rem;
    margin-top: -5rem;
    position: relative;
    z-index: 1;
    .social-sidebar-list {
      align-items: center;
      display: flex;
      justify-content: space-between;
      .social-sidebar-list-item {
        color: var(--color-word);
        text-decoration: none;
        transition: var(--transition-theme);

        &:hover {
          color: var(--color-accent);
          transform: scale(1.2);
        }
      }
    }

    .social-sidebar-line {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .social-sidebar {
      align-items: center;
      bottom: 0;
      display: flex;
      flex-direction: column;
      margin-bottom: 0;
      position: fixed;
      width: auto;

      .social-sidebar-list {
        flex-direction: column;

        .social-sidebar-list-item {
          padding: var(--spacing-md);
        }
      }
      .social-sidebar-line {
        display: inline-block;
        width: 2px;
        height: 100px;
        background-color: var(--color-word);
      }
    }
  }
</style>
