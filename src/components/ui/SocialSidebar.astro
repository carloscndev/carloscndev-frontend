---
import GithubIcon from "@components/icons/GithubIcon.astro";
import InstagramIcon from "@components/icons/InstagramIcon.astro";
import LinkedInIcon from "@components/icons/LinkedInIcon.astro";
import MailIcon from "@components/icons/MailIcon.astro";
import CVIcon from "@components/icons/CV.astro";
import LinkWrapper from "./LinkWrapper.astro";
import config from "../../data/config.json";
---

<aside class="social-sidebar">
  <ul class="social-sidebar-list" role="list">
    <li class="social-sidebar-list-item">
      <LinkWrapper href={config.social.github} tooltip="GitHub">
        <GithubIcon />
      </LinkWrapper>
    </li>
    <li class="social-sidebar-list-item">
      <LinkWrapper href={config.social.instagram} tooltip="Instagram">
        <InstagramIcon />
      </LinkWrapper>
    </li>
    <li class="social-sidebar-list-item">
      <LinkWrapper href={config.social.cv} tooltip="Resume">
        <CVIcon />
      </LinkWrapper>
    </li>
    <li class="social-sidebar-list-item">
      <LinkWrapper href={config.social.linkedin} tooltip="LinkedIn">
        <LinkedInIcon />
      </LinkWrapper>
    </li>
    <li class="social-sidebar-list-item">
      <LinkWrapper
        href={config.social.email}
        isExternal={false}
        tooltip="Email"
      >
        <MailIcon />
      </LinkWrapper>
    </li>
  </ul>
  <div class="social-sidebar-line"></div>
</aside>

<style>
  .social-sidebar {
    display: block;
    margin: auto;
    width: 60%;
    margin-bottom: 1rem;
    margin-top: -5rem;
    position: relative;
    z-index: 1;
    .social-sidebar-list {
      align-items: center;
      display: flex;
      justify-content: space-between;
      .social-sidebar-list-item {
        color: var(--color-word);
        text-decoration: none;
        transition: var(--transition-theme);

        &:hover {
          color: var(--color-accent);
          transform: scale(1.2);
        }
      }
    }

    .social-sidebar-line {
      display: none;
    }
  }

  @media (min-width: 1025px) {
    .social-sidebar {
      align-items: center;
      bottom: 0;
      display: flex;
      flex-direction: column;
      margin-bottom: 0;
      position: fixed;
      width: auto;

      .social-sidebar-list {
        flex-direction: column;

        .social-sidebar-list-item {
          padding: var(--spacing-md);
        }
      }
      .social-sidebar-line {
        display: inline-block;
        width: 2px;
        height: 100px;
        background-color: var(--color-word);
      }
    }
  }
</style>
