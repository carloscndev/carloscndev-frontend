---
import LinkWrapper from "./LinkWrapper.astro";
import WebIcon from "@components/icons/WebIcon.astro";
import MobileMenuIcon from "@components/icons/MobileMenuIcon.astro";
import ThemeButton from "./ThemeButton.astro";
import LanguageButton from "./LanguageButton.astro";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
const navLinks = [
  { label: "Home", href: "/" },
  { label: "About", href: "/#about" },
  { label: "Portfolio", href: "/#portfolio" },
  { label: "Blog", href: "/#blog" },
  { label: "Contact", href: "/#contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="mobile-menu-wrapper">
    <MobileMenuIcon class="mobile-menu" />
  </div>
  <div class="header-icon">
    <LinkWrapper href="/" isExternal={false}>
      <WebIcon size="50" />
    </LinkWrapper>
  </div>
  <div class="header-menu">
    <nav class="header-nav" aria-label="Main navigation">
      <ul class="header-nav-list" role="list">
        {
          navLinks.map((link) => (
            <li class="header-nav-item">
              <a
                href={link.href}
                class:list={[
                  "header-nav-link",
                  currentPath === link.href ? "header-nav-link--active" : "",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-controls">
      <div id="theme-toggle-button">
        <ThemeButton />
      </div>
      <LanguageButton lang={lang} />
    </div>
  </div>
</header>

<script>
  import { initThemeListener } from "../../utils/theme.ts";

  initThemeListener();
</script>

<style>
  .header {
    align-items: center;
    margin: auto;
    width: 100%;
    display: flex;
    justify-content: space-between;
    height: var(--header-desktop-height);
    padding: 0 var(--spacing-md);

    .mobile-menu-wrapper {
      cursor: pointer;
      flex: 1;
      .mobile-menu {
        fill: var(--text-base);
      }
    }

    .header-icon {
      flex-shrink: 0;
    }

    .header-menu {
      align-items: center;
      display: flex;
      flex: 1;
      justify-content: flex-end;

      .header-nav {
        color: var(--text-base);
        display: none;
        font-family: var(--font-titles);
        font-size: var(--font-size-h3-desktop);
        font-weight: var(--weight-space-medium);
        margin-right: var(--spacing-lg);
        .header-nav-list {
          display: flex;

          .header-nav-item {
            margin-right: var(--spacing-md);
            .header-nav-link--active {
              color: var(--color-accent);
              font-weight: var(--weight-space-semibold);
              text-decoration: underline;
              text-underline-offset: 4px;
              text-decoration-thickness: 2px;
            }
          }
        }
      }

      .header-controls {
        align-items: center;
        display: flex;

        #theme-toggle-button {
          margin-right: var(--spacing-md);
        }
      }
    }
  }

  @media (min-width: 768px) {
    .header {
      padding: 0;
      .mobile-menu-wrapper {
        display: none;
        flex: 0;
      }

      .header-menu {
        .header-nav {
          display: inline-block;
        }
      }
    }
  }
</style>
