---
import LinkWrapper from "./LinkWrapper.astro";
import WebIcon from "@components/icons/WebIcon.astro";
import MobileMenuIcon from "@components/icons/MobileMenuIcon.astro";
import CloseIcon from "@components/icons/CloseIcon.astro";
import ThemeButton from "./ThemeButton.astro";
import LanguageButton from "./LanguageButton.astro";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;

// i18n labels map for navigation
const navLinks = [
  { key: "home", href: "/" },
  { key: "about", href: "/#about" },
  { key: "portfolio", href: "/#portfolio" },
  { key: "blog", href: "/#blog" },
  { key: "contact", href: "/#contact" },
];

const navLabels: Record<string, Record<"es" | "en", string>> = {
  home: { es: "Inicio", en: "Home" },
  about: { es: "Acerca de", en: "About" },
  portfolio: { es: "Portafolio", en: "Portfolio" },
  blog: { es: "Blog", en: "Blog" },
  contact: { es: "Contacto", en: "Contact" },
};

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="mobile-menu-wrapper" data-mobile-menu-toggle>
    <MobileMenuIcon class="mobile-menu" />
  </div>
  <div class="header-icon">
    <LinkWrapper href="/" isExternal={false}>
      <WebIcon size="50" />
    </LinkWrapper>
  </div>
  <div class="header-menu">
    <nav class="header-nav" aria-label="Main navigation">
      <ul class="header-nav-list" role="list">
        {
          navLinks.map((link) => (
            <li class="header-nav-item">
              <a
                href={link.href}
                class:list={[
                  "header-nav-link",
                  currentPath === link.href ? "header-nav-link--active" : "",
                ]}
                data-i18n-nav={link.key}
              >
                {navLabels[link.key][lang]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-controls">
      <div id="theme-toggle-button">
        <ThemeButton />
      </div>
      <LanguageButton lang={lang} />
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div
  id="mobile-menu"
  class="mobile-menu"
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
>
  <div class="mobile-menu-content">
    <button
      class="mobile-menu-close"
      data-mobile-menu-close
      aria-label="Close menu"
    >
      <CloseIcon size="32" />
    </button>
    <nav class="mobile-menu-nav" aria-label="Mobile navigation">
      <ul class="mobile-menu-list" role="list">
        {
          navLinks.map((link) => (
            <li class="mobile-menu-item">
              <a
                href={link.href}
                class="mobile-menu-link"
                data-mobile-menu-link
                data-i18n-nav={link.key}
              >
                {navLabels[link.key][lang]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</div>

<script>
  import { initThemeListener } from "../../utils/theme.ts";
  import { initMobileMenuListener } from "../../utils/mobile-menu.ts";

  initThemeListener();
  initMobileMenuListener();
</script>

<style>
  .header {
    align-items: center;
    margin: auto;
    width: 100%;
    display: flex;
    justify-content: space-between;
    height: var(--header-desktop-height);
    padding: 0 var(--spacing-md);

    .mobile-menu-wrapper {
      cursor: pointer;
      flex: 1;
      .mobile-menu {
        fill: var(--text-base);
      }
    }

    .header-icon {
      flex-shrink: 0;
      display: flex;
      align-items: center;
    }

    .header-menu {
      align-items: center;
      display: flex;
      flex: 1;
      justify-content: flex-end;

      .header-nav {
        color: var(--text-base);
        display: none;
        font-family: var(--font-titles);
        font-size: var(--font-size-h3-desktop);
        font-weight: var(--weight-space-medium);
        margin-right: var(--spacing-lg);
        .header-nav-list {
          display: flex;

          .header-nav-item {
            margin-right: var(--spacing-md);
            .header-nav-link--active {
              color: var(--color-accent);
              font-weight: var(--weight-space-semibold);
              text-decoration: underline;
              text-underline-offset: 4px;
              text-decoration-thickness: 2px;
            }
          }
        }
      }

      .header-controls {
        align-items: center;
        display: flex;

        #theme-toggle-button {
          margin-right: var(--spacing-md);
        }
      }
    }
  }

  /* Mobile Menu Overlay */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: var(--bg-primary);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity duration-300 ease-in-out,
      visibility duration-300 ease-in-out;

    &[data-open="true"] {
      opacity: 1;
      visibility: visible;
    }

    .mobile-menu-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      width: 100%;
      padding: var(--spacing-lg);
    }

    .mobile-menu-close {
      position: absolute;
      top: var(--spacing-lg);
      right: var(--spacing-lg);
      background: transparent;
      border: none;
      cursor: pointer;
      padding: var(--spacing-sm);
      color: var(--text-base);
      transition: transform duration-300 ease-in-out;
      svg {
        fill: var(--text-base);
      }
    }

    .mobile-menu-nav {
      width: 100%;
      max-width: 300px;
    }

    .mobile-menu-list {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-lg);
    }

    .mobile-menu-item {
      text-align: center;
    }

    .mobile-menu-link {
      font-family: var(--font-titles);
      font-size: var(--font-size-h2-mobile);
      font-weight: var(--weight-space-medium);
      color: var(--text-base);
      transition: color duration-300 ease-in-out;

      &:hover {
        color: var(--color-accent);
      }

      &:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 4px;
        border-radius: 4px;
      }
    }
  }

  @media (min-width: 768px) {
    .header {
      padding: 0;
      .mobile-menu-wrapper {
        display: none;
        flex: 0;
      }

      .header-menu {
        .header-nav {
          display: inline-block;
        }
      }
    }

    .mobile-menu {
      display: none;
    }
  }
</style>
