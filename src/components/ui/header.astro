---
import LinkWrapper from "./LinkWrapper.astro";
import WebIcon from "@components/icons/WebIcon.astro";
import MobileMenuIcon from "@components/icons/MobileMenuIcon.astro";
import CloseIcon from "@components/icons/CloseIcon.astro";
import ThemeButton from "./ThemeButton.astro";
import LanguageButton from "./LanguageButton.astro";
import { NAV_LABELS } from "../../utils/lang";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;

const navLinks = [
  { key: "home", href: "/" },
  { key: "about", href: "/#about" },
  { key: "portfolio", href: "/#portfolio" },
  { key: "blog", href: "/#blog" },
  { key: "contact", href: "/#contact" },
];

const currentPath = Astro.url.pathname;
const currentHash = Astro.url.hash || "";
const fullPath = currentPath + currentHash;
---

<header class="header">
  <button
    class="mobile-menu-toggle"
    data-mobile-menu-toggle
    aria-label="Open navigation menu"
    aria-expanded="false"
    type="button"
  >
    <MobileMenuIcon class="mobile-menu-toggle__icon" />
  </button>
  <div class="header-icon">
    <LinkWrapper href="/" isExternal={false}>
      <WebIcon size="50" />
    </LinkWrapper>
  </div>
  <div class="header-menu">
    <nav class="header-nav" aria-label="Main navigation">
      <ul class="header-nav-list" role="list">
        {
          navLinks.map((link) => (
            <li class="header-nav-item">
              <a
                href={link.href}
                class:list={[
                  "header-nav-link",
                  fullPath === link.href ? "header-nav-link--active" : "",
                ]}
                data-i18n-nav={link.key}
              >
                {NAV_LABELS[link.key][lang]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-controls">
      <div id="theme-toggle-button">
        <ThemeButton />
      </div>
      <LanguageButton lang={lang} />
    </div>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div
  id="mobile-menu"
  class="mobile-menu-overlay"
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
>
  <div class="mobile-menu-content">
    <div class="mobile-menu-header">
      <button
        class="mobile-menu-close"
        data-mobile-menu-close
        aria-label="Close menu"
        type="button"
      >
        <CloseIcon size="32" />
      </button>
      <div class="mobile-menu-header-controls">
        <div id="theme-toggle-mobile" class="mobile-menu-theme">
          <ThemeButton />
        </div>
        <LanguageButton lang={lang} id="language-toggle-mobile" />
      </div>
    </div>
    <nav class="mobile-menu-nav" aria-label="Mobile navigation">
      <ul class="mobile-menu-list" role="list">
        {
          navLinks.map((link) => (
            <li class="mobile-menu-item">
              <a
                href={link.href}
                class:list={[
                  "mobile-menu-link",
                  fullPath === link.href ? "mobile-menu-link--active" : "",
                ]}
                data-mobile-menu-link
                data-i18n-nav={link.key}
              >
                {NAV_LABELS[link.key][lang]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mobile-menu-web">
      <WebIcon size="60" />
    </div>
  </div>
</div>

<script>
  import { initThemeListener } from "../../utils/theme.ts";
  import { initMobileMenuListener } from "../../utils/mobile-menu.ts";

  initThemeListener();
  initMobileMenuListener();
</script>

<style>
  .header {
    align-items: center;
    margin: auto;
    width: 100%;
    display: flex;
    justify-content: space-between;
    height: var(--header-desktop-height);
    padding: 0 var(--spacing-md);

    .mobile-menu-toggle {
      background: transparent;
      border: none;
      cursor: pointer;
      flex: 1;
      padding: var(--spacing-sm);
      display: flex;
      align-items: center;

      .mobile-menu-toggle__icon {
        fill: var(--text-base);
      }
    }

    .header-icon {
      flex-shrink: 0;
      display: flex;
      align-items: center;
    }

    .header-menu {
      align-items: center;
      display: flex;
      flex: 1;
      justify-content: flex-end;

      .header-nav {
        color: var(--text-base);
        display: none;
        font-family: var(--font-titles);
        font-size: var(--font-size-h3-desktop);
        font-weight: var(--weight-space-medium);
        margin-right: var(--spacing-lg);
        .header-nav-list {
          display: flex;

          .header-nav-item {
            margin-right: var(--spacing-md);
            .header-nav-link--active {
              color: var(--color-accent);
              font-weight: var(--weight-space-semibold);
              text-decoration: underline;
              text-underline-offset: 4px;
              text-decoration-thickness: 2px;
            }
          }
        }
      }

      .header-controls {
        align-items: center;
        display: flex;

        #theme-toggle-button {
          margin-right: var(--spacing-md);
        }
      }
    }
  }

  /* Mobile Menu Overlay */
  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: var(--bg-primary);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 300ms ease-in-out,
      visibility 300ms ease-in-out;

    &[data-open="true"] {
      opacity: 1;
      visibility: visible;

      .mobile-menu-content {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .mobile-menu-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      width: 100%;
      padding: var(--spacing-lg);
      gap: var(--spacing-xl);
      position: relative;
      opacity: 0;
      transform: translateY(20px);
      transition:
        opacity 300ms ease-in-out,
        transform 300ms ease-in-out;
    }

    .mobile-menu-header {
      position: absolute;
      top: -7px;
      left: 0;
      right: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: var(--header-desktop-height);
      padding: 0 var(--spacing-md);
    }

    .mobile-menu-header-controls {
      display: flex;
      align-items: center;
      gap: var(--spacing-md);
    }

    .mobile-menu-close {
      background: transparent;
      border: none;
      cursor: pointer;
      padding: var(--spacing-sm);
      color: var(--text-base);
      transition: transform 300ms ease-in-out;

      &:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 4px;
        border-radius: 4px;
      }

      svg {
        fill: var(--text-base);
      }
    }

    .mobile-menu-nav {
      width: 100%;
      max-width: 300px;
    }

    .mobile-menu-list {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-lg);
    }

    .mobile-menu-item {
      text-align: center;
    }

    .mobile-menu-link {
      font-family: var(--font-titles);
      font-size: var(--font-size-h2-mobile);
      font-weight: var(--weight-space-medium);
      color: var(--text-base);
      transition: color 300ms ease-in-out;

      &.mobile-menu-link--active {
        color: var(--color-accent);
        font-weight: var(--weight-space-semibold);
      }

      &:hover {
        color: var(--color-accent);
      }

      &:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 4px;
        border-radius: 4px;
      }
    }

    .mobile-menu-web {
      position: absolute;
      bottom: var(--spacing-lg);
      right: var(--spacing-lg);
      color: var(--color-word);
      display: inline-flex;
      align-items: center;
      transition: color 300ms ease;
    }

    .mobile-menu-web:hover {
      color: var(--color-accent);
    }
  }

  /* Prevent icon flicker during theme transitions (Safari) */
  :global(.mobile-menu-toggle__icon),
  :global(.mobile-menu-toggle__icon path),
  :global(.mobile-menu-close svg),
  :global(.mobile-menu-close path) {
    transition: none;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-overlay {
      transition: none;
    }

    .mobile-menu-close {
      transition: none;
    }

    .mobile-menu-link {
      transition: none;
    }
  }

  @media (min-width: 768px) {
    .header {
      padding: 0;

      .mobile-menu-toggle {
        display: none;
        flex: 0;
      }

      .header-menu {
        .header-nav {
          display: inline-block;
        }
      }
    }

    .mobile-menu-overlay {
      display: none;
    }
  }
</style>
