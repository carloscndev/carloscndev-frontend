---
import GlobeIcon from "@components/icons/GlobeIcon.astro";

interface Props {
  lang?: "es" | "en";
}

const { lang = "es" } = Astro.props;
---

<div class="language-button">
  <div class="icon-wrapper">
    <GlobeIcon />
  </div>
  <div class="current-language-text">{lang === "es" ? "Es" : "En"}</div>
</div>

<style>
  .language-button {
    align-items: center;
    display: flex;
    cursor: pointer;

    .icon-wrapper {
      margin-right: 2px;
    }

    .current-language-text {
      font-family: var(--font-titles);
      font-weight: var(--weight-space-medium);
      padding-top: 0.5rem;
    }
  }
</style>
