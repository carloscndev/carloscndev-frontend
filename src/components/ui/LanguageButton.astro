---
import GlobeIcon from "@components/icons/GlobeIcon.astro";

interface Props {
  lang?: "es" | "en";
  id?: string;
}

const { lang = "es", id = "language-toggle" } = Astro.props;
---

<div
  class="language-button"
  id={id}
  role="button"
  tabindex="0"
  aria-label={`Switch language, currently ${lang === "es" ? "Spanish" : "English"}`}
>
  <div class="icon-wrapper">
    <GlobeIcon />
  </div>
  <div class="current-language-text" data-lang-indicator>
    {lang === "es" ? "Es" : "En"}
  </div>
</div>

<script>
  import { initLangListener } from "../../utils/lang.ts";

  initLangListener();
</script>

<style>
  .language-button {
    align-items: center;
    display: flex;
    cursor: pointer;
    transition: opacity 300ms ease-in-out;
    .icon-wrapper {
      margin-right: 2px;
    }
    .current-language-text {
      font-family: var(--font-titles);
      font-weight: var(--weight-space-medium);
      padding-top: 0.5rem;
      color: var(--text-base);
    }
  }

  :global(.language-button .icon-wrapper) {
    color: var(--text-base);
    transition: none;
  }

  :global(.language-button .icon-wrapper svg) {
    transition: none;
  }
</style>
