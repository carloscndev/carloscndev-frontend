---
import { Image } from "astro:assets";
import wallperImage from "../../assets/images/wallper.jpg";
import TechIcon from "../icons/TechIcon.astro";
import RunningIcon from "../icons/RunningIcon.astro";
import ExternalLink from "../icons/ExternalLink.astro";
import LinkWrapper from "./LinkWrapper.astro";

export interface Props {
  id: string;
  title: string;
  link: string;
  icon: string;
  category: string;
  date: string;
  readTime: string;
  resume: string;
}

const { id, title, link, icon, category, date, readTime, resume } = Astro.props;
const categoryTheme = icon === "tech-icon" ? "tech" : "running";
---

<LinkWrapper
  href={link}
  isExternal={false}
  class="blog-card"
  data-post-id={id}
  data-category-theme={categoryTheme}
  aria-label={title}
>
  <div class="blog-card__image">
    <Image
      src={wallperImage}
      alt={title}
      class="blog-card__image-img"
      loading="lazy"
    />
    <div class="blog-card__overlay">
      <p class="blog-card__overlay-text">{resume || ""}</p>
    </div>
  </div>
  <ExternalLink size="18" class="blog-card__overlay-icon" />
  <div class="blog-card__content">
    <h3 class="blog-card__title" data-post-title>
      {title}
    </h3>
    <span class="blog-card__read-time" data-post-read-time>
      {readTime}
    </span>
    <div class="blog-card__meta">
      <span class="blog-card__date" data-post-date>
        {date}
      </span>
      <span class="blog-card__category" data-post-category>
        {category}
        {
          icon === "tech-icon" ? (
            <TechIcon size="14" class="blog-card__category-icon" />
          ) : (
            <RunningIcon size="14" class="blog-card__category-icon" />
          )
        }
      </span>
    </div>
  </div>
</LinkWrapper>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--border-radius);
    background: var(--color-tech-primary-light);
    position: relative;
    transition:
      transform 300ms ease,
      box-shadow 300ms ease;
    overflow: hidden;
    text-decoration: none;
  }

  .blog-card[data-category-theme="tech"] {
    background: var(--color-tech-primary-light);
  }

  .blog-card[data-category-theme="running"] {
    background: var(--color-running-primary-light);
  }

  :global(.dark) .blog-card[data-category-theme="tech"] {
    background: var(--color-tech-primary-dark);
  }

  :global(.dark) .blog-card[data-category-theme="running"] {
    background: var(--color-running-primary-dark);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  :global(.dark) .blog-card:hover {
    box-shadow: var(--shadow-card-dark);
  }

  .blog-card__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    position: relative;
  }

  .blog-card__image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 300ms ease;
  }

  .blog-card:hover .blog-card__image-img {
    opacity: 0.2;
  }

  .blog-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: var(--spacing-md);
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .blog-card:hover .blog-card__overlay {
    opacity: 1;
  }

  :global(.blog-card__overlay-icon) {
    position: absolute;
    top: var(--spacing-sm);
    right: var(--spacing-sm);
    color: var(--text-base);
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .blog-card:hover :global(.blog-card__overlay-icon) {
    opacity: 1;
  }

  .blog-card__overlay-text {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--text-base);
    line-height: 1.5;
    text-align: center;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
  }

  .blog-card__content {
    padding: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .blog-card__title {
    font-family: var(--font-titles);
    font-size: var(--font-size-h3-mobile);
    font-weight: var(--weight-space-semibold);
    color: var(--text-base);
    line-height: 1.3;
  }

  .blog-card__category {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-titles);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-word);
  }

  :global(.blog-card__category-icon) {
    display: inline-block;
    flex-shrink: 0;
    color: inherit;
  }

  .blog-card__read-time {
    font-size: 0.8rem;
    color: var(--color-word);
    margin-bottom: 0.25rem;
  }

  .blog-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--color-word);
  }

  /* Category-themed text colors */
  .blog-card[data-category-theme="tech"] .blog-card__title,
  .blog-card[data-category-theme="tech"] .blog-card__read-time,
  .blog-card[data-category-theme="tech"] .blog-card__meta,
  .blog-card[data-category-theme="tech"] .blog-card__category {
    color: var(--color-tech-secondary-light);
  }

  .blog-card[data-category-theme="running"] .blog-card__title,
  .blog-card[data-category-theme="running"] .blog-card__read-time,
  .blog-card[data-category-theme="running"] .blog-card__meta,
  .blog-card[data-category-theme="running"] .blog-card__category {
    color: var(--color-running-secondary-light);
  }

  :global(.dark) .blog-card[data-category-theme="tech"] .blog-card__title,
  :global(.dark) .blog-card[data-category-theme="tech"] .blog-card__read-time,
  :global(.dark) .blog-card[data-category-theme="tech"] .blog-card__meta,
  :global(.dark) .blog-card[data-category-theme="tech"] .blog-card__category {
    color: var(--color-tech-secondary-dark);
  }

  :global(.dark) .blog-card[data-category-theme="running"] .blog-card__title,
  :global(.dark)
    .blog-card[data-category-theme="running"]
    .blog-card__read-time,
  :global(.dark) .blog-card[data-category-theme="running"] .blog-card__meta,
  :global(.dark)
    .blog-card[data-category-theme="running"]
    .blog-card__category {
    color: var(--color-running-secondary-dark);
  }

  @media (min-width: 768px) {
    .blog-card__title {
      font-size: var(--font-size-h3-desktop);
    }
  }
</style>
