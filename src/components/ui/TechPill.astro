---
interface Props {
  label: string;
  variant?: "default" | "card";
}

const { label, variant = "default" } = Astro.props;
---

<span class:list={["tech-pill", variant === "card" ? "tech-pill--card" : ""]}>
  {label}
</span>

<style>
  :global(.tech-pill) {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: var(--weight-inter-regular);
    color: var(--text-base);
    background: var(--pill-bg);
    border-radius: 30px;
    border: none;
    box-shadow: none;
    padding: 0.5rem 0.75rem;
    margin-right: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
  }

  :global(.tech-pill--card) {
    font-size: 0.75rem;
    font-weight: var(--weight-inter-regular);
    padding: 0.5rem 0.75rem;
  }

  @media (min-width: 1025px) {
    :global(.tech-pill) {
      font-size: 1.125rem;
      font-weight: var(--weight-inter-medium);
      padding: 0.5rem 1rem;
    }

    :global(.tech-pill--card) {
      font-size: 0.75rem;
      font-weight: var(--weight-inter-regular);
      padding: 0.5rem 0.75rem;
    }
  }
</style>
