---
interface Props {
  href: string;
  isExternal?: boolean;
  title?: string;
  tooltip?: string;
  class?: string;
  rel?: string;
}

const {
  href,
  isExternal = true,
  title,
  tooltip,
  class: className,
  ...rest
} = Astro.props;

const safeHref = href ?? "#";
const isMail = safeHref.startsWith("mailto:");
const useTargetBlank = isExternal && !isMail;
---

<a
  href={href}
  target={useTargetBlank ? "_blank" : undefined}
  rel={useTargetBlank ? "noopener" : undefined}
  title={title}
  class:list={["link", className]}
  {...rest}
>
  <slot />
  {tooltip && <span class="link-tooltip">{tooltip}</span>}
</a>

<style>
  .link {
    position: relative;
    display: inline-flex;
  }

  :global(.link-tooltip) {
    position: absolute;
    bottom: 100%;
    right: 0;
    transform: translateX(60%);
    margin-bottom: 4px;
    background: var(--color-accent);
    color: var(--text-base);
    font-family: var(--font-body);
    font-size: 0.7rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .link:hover :global(.link-tooltip) {
    opacity: 1;
  }
</style>
