---
interface Props {
  title: string;
  description?: string;
  image?: string;
  keywords?: string;
  metaRobots?: string;
  category?: string;
}

const {
  title,
  description,
  image,
  keywords,
  metaRobots = "noindex, follow",
  category,
} = Astro.props;

const SITE = Astro.site?.origin ?? "https://carloscndev.com";
const siteDescription =
  description ||
  "Carlos Castañeda — Software Engineer. Portfolio, blog, and projects.";

const ogImage = image
  ? image.startsWith("http")
    ? image
    : `${import.meta.env.PUBLIC_STRAPI_URL}${image}`
  : `${SITE}/default-share-image.png`;
---

<meta name="description" content={siteDescription} />
{keywords && <meta name="keywords" content={keywords} />}
{metaRobots && <meta name="robots" content={metaRobots} />}
{category && <meta name="category-theme" content={category} />}

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={siteDescription} />
<meta property="og:type" content="website" />
<meta property="og:url" content={new URL(Astro.url.pathname, SITE).href} />
<meta property="og:image" content={ogImage} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={siteDescription} />
<meta name="twitter:image" content={ogImage} />
