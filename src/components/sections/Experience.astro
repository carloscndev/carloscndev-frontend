---
import experienceDataRaw from "../../data/experience.json";
import Chevron from "../icons/Chevron.astro";
import TechPill from "../ui/TechPill.astro";
import LinkWrapper from "../ui/LinkWrapper.astro";

const currentLang = "es";
const data = experienceDataRaw[currentLang];

const embeddedData = {
  es: experienceDataRaw.es,
  en: experienceDataRaw.en,
};
const embeddedDataJson = JSON.stringify(embeddedData);
---

<section id="experience" class="experience-section">
  <script
    type="application/json"
    id="experience-data"
    set:html={embeddedDataJson}
  />

  <header class="experience-section__header">
    <h2 class="experience-section__title" data-experience-title>
      {data.title}
    </h2>
    <p class="experience-section__intro" data-experience-intro>{data.intro}</p>
  </header>

  <!-- DESKTOP: TABLE/TABS -->
  <div class="experience-tabs">
    <div class="experience-tabs__list" role="tablist">
      {
        data.jobs.map((job, idx) => (
          <button
            class:list={[
              "experience-tabs__tab",
              idx === 0 ? "experience-tabs__tab--active" : "",
            ]}
            role="tab"
            aria-selected={idx === 0 ? "true" : "false"}
            data-tab={job.id}
            type="button"
          >
            <Chevron size="14" class="experience-tabs__chevron" />
            <span class="experience-tabs__tab-company">{job.company}</span>
          </button>
        ))
      }
    </div>

    <div class="experience-tabs__content">
      {
        data.jobs.map((job, idx) => (
          <div
            class:list={[
              "experience-tabs__panel",
              idx === 0 ? "experience-tabs__panel--active" : "",
            ]}
            role="tabpanel"
            data-panel={job.id}
          >
            <div class="experience-tabs__heading">
              <h3 class="experience-tabs__role" data-job-role>
                {job.role}
              </h3>
              <LinkWrapper
                href={job.company_url}
                class="experience-tabs__company"
                data-job-company
              >
                @{job.company}
              </LinkWrapper>
            </div>
            <p class="experience-tabs__period" data-job-period>
              {job.period}
            </p>
            <div class="experience-tabs__description" data-job-description>
              {job.description.map((paragraph: string) => (
                <p>{paragraph}</p>
              ))}
            </div>
            <div class="experience-tabs__tags" data-job-tags>
              {job.technologies.map((tech) => (
                <TechPill label={tech} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- MOBILE: CAROUSEL -->
  <div class="experience-carousel">
    <div class="experience-carousel__track" data-carousel-track>
      {
        data.jobs.map((job, idx) => (
          <div
            class:list={[
              "experience-carousel__slide",
              idx === 0 ? "experience-carousel__slide--active" : "",
            ]}
            data-slide={job.id}
          >
            <div class="experience-tabs__heading">
              <h3 class="experience-carousel__role" data-job-role>
                {job.role}
              </h3>
              <LinkWrapper
                href={job.company_url}
                class="experience-carousel__company"
                data-job-company
              >
                @{job.company}
              </LinkWrapper>
            </div>
            <p class="experience-carousel__period" data-job-period>
              {job.period}
            </p>
            <div class="experience-carousel__description" data-job-description>
              {job.description.map((paragraph: string) => (
                <p>{paragraph}</p>
              ))}
            </div>
            <div class="experience-carousel__tags" data-job-tags>
              {job.technologies.map((tech) => (
                <TechPill label={tech} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
    <div class="experience-carousel__dots" data-carousel-dots>
      {
        data.jobs.map((_, idx) => (
          <button
            class:list={[
              "experience-carousel__dot",
              idx === 0 ? "experience-carousel__dot--active" : "",
            ]}
            data-dot={String(idx)}
            type="button"
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  import {
    initExperienceLangSwitch,
    initExperienceTabs,
    initExperienceCarousel,
  } from "../../utils/experience.ts";
  initExperienceLangSwitch();
  initExperienceTabs();
  initExperienceCarousel();
</script>

<style>
  .experience-section {
    padding: var(--spacing-lg);
    width: 100%;
    max-width: 100vw;
    overflow: hidden;
    box-sizing: border-box;
  }

  .experience-section__title {
    margin-bottom: var(--spacing-sm);
  }

  .experience-section__intro {
    color: var(--text-base);
    margin-bottom: 1rem;
  }

  /* --- DESKTOP (Grid Layout) --- */
  .experience-tabs {
    display: none;
  }

  @media (min-width: 768px) {
    .experience-carousel {
      display: none;
    }

    .experience-section__title {
      margin-bottom: 1rem;
    }

    .experience-section__intro {
      margin-bottom: 2rem;
    }

    .experience-tabs {
      display: grid;
      grid-template-columns: 250px 1fr;
      gap: var(--spacing-xl);
    }
    .experience-tabs__list {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
    }
    .experience-tabs__tab {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      padding: var(--spacing-md);
      background: none;
      border: none;
      color: var(--text-base);
      font-family: var(--font-titles);
      cursor: pointer;
      text-align: left;
      transition: 300ms;
    }
    .experience-tabs__tab--active {
      background: rgba(51, 31, 232, 0.2);
    }
    :global(.experience-tabs__chevron) {
      color: var(--color-accent);
      flex-shrink: 0;
      opacity: 0;
      transition: opacity 300ms ease;
    }

    .experience-tabs__tab--active :global(.experience-tabs__chevron) {
      opacity: 1;
    }
    .experience-tabs__panel {
      display: none;
      transition: none;
    }
    .experience-tabs__panel--active {
      display: block;
    }

    .experience-tabs__description {
      color: var(--text-base);
      transition: none;
      display: flex;
      flex-direction: column;
      gap: var(--spacing-lg);
    }

    .experience-tabs__description p {
      margin: 0;
    }

    .experience-tabs__heading {
      display: flex;
      align-items: baseline;
      gap: var(--spacing-sm);
      flex-wrap: wrap;
    }

    .experience-tabs__role {
      font-family: var(--font-titles);
      font-size: var(--font-size-h2-desktop);
      font-weight: var(--weight-space-semibold);
      color: var(--text-base);
      margin: 0;
    }

    :global(.experience-tabs__company) {
      font-family: var(--font-titles);
      font-size: var(--font-size-h2-desktop);
      font-weight: var(--weight-space-semibold);
      color: var(--color-accent);
      margin: 0;
      text-decoration: none;
    }
    .experience-tabs__period {
      color: var(--color-word);
      font-size: 0.875rem;
      margin-bottom: var(--spacing-md-lg);
    }
    .experience-tabs__tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
      margin-top: 2rem;
    }
    .experience-tabs__tag {
      background: rgba(51, 31, 232, 0.1);
      border: 1px solid rgba(51, 31, 232, 0.2);
      padding: 0.25rem 0.75rem;
      border-radius: 4px;
      font-size: 0.875rem;
    }
  }

  /* --- MOBILE (Carousel Layout) --- */
  @media (max-width: 767px) {
    .experience-carousel {
      width: 100%;
      position: relative;
    }
    .experience-carousel__track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .experience-carousel__track::-webkit-scrollbar {
      display: none;
    }
    .experience-carousel__slide {
      flex: 0 0 100%;
      min-width: 100%;
      scroll-snap-align: start;
      box-sizing: border-box;
      padding: var(--spacing-md);
      transition: none;
    }

    .experience-carousel__description {
      color: var(--text-base);
      transition: none;
    }

    .experience-carousel__description p {
      margin-bottom: var(--spacing-sm);
    }

    .experience-carousel__description p:last-child {
      margin-bottom: 0;
    }

    .experience-carousel__tags {
      margin-top: 1rem;
    }

    .experience-carousel__dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 1rem;
    }
    .experience-carousel__dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      border: none;
      background: var(--color-word);
    }
    .experience-carousel__dot--active {
      background: var(--color-accent);
    }
    .experience-tabs__heading {
      display: flex;
      align-items: baseline;
      gap: var(--spacing-sm);
      flex-wrap: wrap;
    }

    .experience-carousel__role {
      font-size: 1.25rem;
      margin: 0;
      color: var(--text-base);
    }

    :global(.experience-carousel__company) {
      font-family: var(--font-titles);
      font-size: 1.25rem;
      font-weight: var(--weight-space-semibold);
      color: var(--color-accent);
      margin: 0;
      text-decoration: none;
    }

    .experience-carousel__period {
      color: var(--color-word);
      margin-bottom: var(--spacing-sm);
    }

    .experience-carousel__description {
      color: var(--text-base);
    }

    .experience-carousel__tag {
      display: inline-block;
      background: rgba(51, 31, 232, 0.1);
      padding: 2px 8px;
      border-radius: 4px;
      margin: 2px;
      font-size: 0.75rem;
    }
  }
</style>
