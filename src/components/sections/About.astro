---
import type { StrapiMedia } from "../../types/strapi";
import StrapiImage from "../ui/StrapiImage.astro";
import Diamond from "../icons/Diamond.astro";

interface TechItem {
  name: string;
  icon: string;
}

interface AboutData {
  title: string;
  contentText: string;
  technologies: TechItem[];
  image: StrapiMedia;
}

interface Props {
  es: AboutData;
  en: AboutData;
}

const { es, en } = Astro.props;
const aboutData = es;

const avatarPath = aboutData.image?.url || "";

const embeddedData = {
  es: { ...es, avatarPath },
  en: { ...en, avatarPath },
};

const embeddedDataJson = JSON.stringify(embeddedData);
---

<section id="about" class="about-section">
  <script
    is:inline
    type="application/json"
    id="about-data"
    set:html={embeddedDataJson}
  />
  <template id="tech-chip-template">
    <span class="about-section__tech-chip">
      <Diamond size="16" class="about-section__tech-icon" />
      <span data-tech-name></span>
    </span>
  </template>

  <div class="about-section__grid">
    <div class="about-section__content">
      <h2
        class="about-section__title"
        data-about-title
        data-i18n-content="section.about"
      >
        {aboutData.title}
      </h2>

      <div
        class="about-section__body"
        data-about-content
        set:html={aboutData.contentText}
      />

      <div class="about-section__tech" data-about-tech>
        {
          aboutData.technologies.map((tech) => (
            <span class="about-section__tech-chip">
              <Diamond size="16" class="about-section__tech-icon" />
              <span data-tech-name>{tech.name}</span>
            </span>
          ))
        }
      </div>
    </div>

    <div class="about-section__avatar">
      {
        aboutData.image ? (
          <StrapiImage
            image={aboutData.image}
            alt={aboutData.title}
            class="about-section__avatar-img"
            loading="lazy"
          />
        ) : (
          <div class="about-section__avatar-placeholder" />
        )
      }
    </div>
  </div>
</section>

<script>
  import { initAboutLangSwitch } from "../../utils/about.ts";
  initAboutLangSwitch();
</script>

<style>
  .about-section {
    height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--spacing-lg);
  }

  .about-section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
    align-items: center;
    width: 100%;
    max-width: var(--max-width);
  }

  .about-section__avatar {
    display: flex;
    justify-content: center;
    order: -1;
  }

  .about-section__avatar-img,
  .about-section__avatar-placeholder {
    width: 180px;
    height: auto;
    border-radius: var(--border-radius);
  }

  .about-section__avatar-placeholder {
    background: var(--color-word);
    opacity: 0.15;
    aspect-ratio: 1 / 1;
  }

  .about-section__content {
    text-align: left;
  }

  .about-section__title {
    margin-bottom: var(--spacing-md);
  }

  .about-section__body {
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    line-height: 1.8;
    color: var(--text-base);
  }

  .about-section__body :global(p) {
    margin-bottom: var(--spacing-md);
  }

  .about-section__body :global(strong) {
    color: var(--color-word);
    font-weight: var(--weight-space-medium);
  }

  .about-section__tech {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-sm);
    margin-top: var(--spacing-md);
  }
  :global(.about-section__tech-chip) {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    color: var(--text-base);
    padding: var(--spacing-xs) var(--spacing-sm);
  }

  :global(.about-section__tech-icon) {
    color: var(--color-accent);
    display: inline;
    flex-shrink: 0;
    margin-right: var(--spacing-sm);
  }

  @media (max-height: 667px) {
    .about-section__avatar-img {
      width: 130px;
    }
  }

  @media (min-width: 768px) {
    .about-section {
      padding: 0 0 0 var(--spacing-lg);
    }

    .about-section__grid {
      grid-template-columns: 65% 1fr;
      gap: var(--spacing-xl);
    }

    .about-section__avatar {
      justify-content: flex-end;
      order: 0;
    }

    .about-section__avatar-img {
      width: 350px;
    }

    .about-section__title {
      font-size: var(--font-size-h2-desktop);
    }

    .about-section__body {
      font-size: var(--font-size-body-desktop);
    }

    :global(.about-section__tech-chip) {
      font-size: var(--font-size-body-desktop);
    }
  }
</style>
