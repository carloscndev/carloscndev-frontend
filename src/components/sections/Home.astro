---
import type { StrapiMedia } from "../../types/strapi";
import StrapiImage from "../ui/StrapiImage.astro";

interface HomeData {
  intro: string;
  title: string;
  subtitle: string;
  content: string;
  avatarDefault: StrapiMedia;
  avatarRunning: StrapiMedia;
  avatarReading: StrapiMedia;
  avatarVideogames: StrapiMedia;
}

interface Props {
  es: HomeData;
  en: HomeData;
}

const { es, en } = Astro.props;
const homeData = es;

const avatarMap: Record<string, StrapiMedia> = {
  default: homeData.avatarDefault,
  running: homeData.avatarRunning,
  reading: homeData.avatarReading,
  videogames: homeData.avatarVideogames,
};

const subtitleHTML = homeData.subtitle.replace(/dev$/, "<strong>dev</strong>");

const embeddedData = {
  es: {
    ...es,
    avatarPaths: Object.fromEntries(
      Object.entries(avatarMap).map(([k, v]) => [k, v.url]),
    ),
  },
  en: {
    ...en,
    avatarPaths: Object.fromEntries(
      Object.entries(avatarMap).map(([k, v]) => [k, v.url]),
    ),
  },
};
const embeddedDataJson = JSON.stringify(embeddedData);
---

<section id="home" class="home-section">
  <script
    is:inline
    type="application/json"
    id="home-data"
    set:html={embeddedDataJson}
  />

  <div class="home-section__grid">
    <div class="home-section__avatar">
      <StrapiImage
        image={avatarMap.default}
        alt={`${homeData.intro} ${homeData.title}`}
        class="home-section__avatar-img"
        loading="eager"
      />
    </div>

    <div class="home-section__content">
      <p class="home-section__intro" data-home-intro>
        {homeData.intro}
      </p>
      <h1 class="home-section__title" data-home-title>
        {homeData.title}
      </h1>
      <p class="home-section__subtitle" set:html={subtitleHTML} />
      <div
        class="home-section__body"
        data-home-content
        set:html={homeData.content}
      />
    </div>
  </div>
</section>

<script>
  import { initHomeLangSwitch, initHomeHobbies } from "../../utils/home.ts";
  initHomeLangSwitch();
  initHomeHobbies();
</script>

<style>
  .home-section {
    height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--spacing-lg);
  }

  .home-section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
    align-items: center;
    width: 100%;
    max-width: var(--max-width);
  }

  .home-section__avatar {
    display: flex;
    justify-content: center;
  }

  .home-section__avatar-img,
  :global(.home-section__avatar-img img) {
    width: 200px;
    height: auto;
    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }

  .home-section__avatar-img--swapping,
  :global(.home-section__avatar-img--swapping img) {
    opacity: 0;
    transform: scale(0.95);
  }

  .home-section__content {
    text-align: left;
  }

  .home-section__intro {
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    color: var(--color-word);
    margin-bottom: var(--spacing-sm);
  }

  .home-section__title {
    margin-bottom: 0;
  }

  .home-section__subtitle {
    font-family: var(--font-titles);
    font-size: var(--font-size-h1-mobile);
    font-weight: var(--weight-space-semibold);
    color: var(--text-base);
    margin-top: 0;
    margin-bottom: var(--spacing-md);
  }

  .home-section__subtitle :global(strong) {
    color: var(--color-accent);
    font-weight: var(--weight-space-medium);
  }

  .home-section__body {
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    line-height: 1.8;
    color: var(--text-base);
  }

  .home-section__body :global(p) {
    margin-bottom: var(--spacing-md);
  }

  .home-section__body :global(strong) {
    color: var(--color-word);
    font-weight: var(--weight-space-medium);
    cursor: pointer;
    transition: color 300ms ease;
  }

  .home-section__body :global(strong):hover {
    color: var(--color-accent);
  }

  @media (max-height: 667px) {
    .home-section__avatar-img,
    :global(.home-section__avatar-img img) {
      width: 140px;
    }
  }

  @media (min-width: 768px) {
    .home-section {
      padding: 0 var(--spacing-lg) 0 0;
    }

    .home-section__grid {
      grid-template-columns: 1fr 65%;
      gap: var(--spacing-xl);
    }

    .home-section__avatar {
      justify-content: flex-end;
      order: 0;
    }

    .home-section__avatar-img,
    :global(.home-section__avatar-img img) {
      width: 350px;
    }

    .home-section__content {
      text-align: left;
    }

    .home-section__intro {
      font-size: var(--font-size-body-desktop);
    }

    .home-section__subtitle {
      font-size: var(--font-size-h1-desktop);
    }

    .home-section__body {
      font-size: var(--font-size-body-desktop);
    }
  }
</style>
