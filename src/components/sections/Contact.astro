---
import contactDataRaw from "../../data/contact.json";

const currentLang = "es";

function getContactData(lang: "es" | "en") {
  const root = contactDataRaw.data.attributes;
  if (root.locale === lang) return root;
  const loc = (root as any).localizations.data.find(
    (l: any) => l.attributes.locale === lang,
  );
  return loc?.attributes ?? root;
}

const data = getContactData(currentLang);

const embeddedData = {
  es: getContactData("es"),
  en: getContactData("en"),
};
const embeddedDataJson = JSON.stringify(embeddedData);
---

<section id="contact" class="contact-section">
  <script
    type="application/json"
    id="contact-data"
    set:html={embeddedDataJson}
  />

  <div class="contact-section__inner">
    <h2 class="contact-section__title" data-contact-title>
      {data.title}
    </h2>

    <p class="contact-section__status" data-contact-status>
      {data.status_message}
    </p>

    <a
      href={data.mail_to}
      class="contact-section__button"
      data-contact-button
      target="_blank"
      rel="noopener"
    >
      {data.button_text}
    </a>
  </div>

  <footer class="contact-section__footer" data-contact-footer>
    {data.footer}
  </footer>
</section>

<script>
  import { initContactLangSwitch } from "../../utils/contact.ts";
  initContactLangSwitch();
</script>

<style>
  section.contact-section {
    height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: var(--spacing-xs) var(--spacing-lg) var(--spacing-lg);
    margin-top: 8vh;
    text-align: center;
    position: relative;
    width: 100%;
  }

  .contact-section__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    flex: 1;
    width: 100%;
  }

  .contact-section__title {
    font-family: var(--font-titles);
    font-size: var(--font-size-h2-mobile);
    font-weight: var(--weight-space-semibold);
    color: var(--text-base);
    margin-bottom: 3rem;
    align-self: center;
  }

  .contact-section__status {
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    color: var(--text-base);
    line-height: 1.8;
    margin-bottom: var(--spacing-lg);
    width: 100%;
  }

  .contact-section__button {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    color: var(--color-accent);
    background: transparent;
    border: 1px solid var(--color-accent);
    border-radius: var(--border-radius);
    padding: var(--spacing-sm) var(--spacing-lg);
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 300ms ease,
      color 300ms ease;
    align-self: center;
  }

  .contact-section__button:hover {
    background-color: var(--color-accent);
    color: var(--bg-primary);
  }

  .contact-section__button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .contact-section__footer {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-word);
    padding-bottom: 2rem;
    width: 100%;
    text-align: center;
    position: absolute;
    bottom: -50px;
    left: 0;
    right: 0;
  }

  @media (min-width: 768px) {
    .contact-section {
      height: 100vh;
      padding: var(--spacing-lg) calc(var(--spacing-lg) * 3);
    }

    .contact-section__footer {
      position: absolute;
      bottom: -200px;
      padding-bottom: 6rem;
      left: 0;
      right: 0;
    }

    .contact-section__title {
      font-size: var(--font-size-h2-desktop);
    }

    .contact-section__status {
      font-size: var(--font-size-body-desktop);
    }

    .contact-section__button {
      font-size: var(--font-size-body-desktop);
    }
  }
</style>
