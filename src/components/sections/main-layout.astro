---
import SocialSidebar from "../ui/social-sidebar.astro";
import "../../styles/global.css";

interface Props {
  title: string;
  lang?: "es" | "en";
}

const { title, lang = "es" } = Astro.props;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Portfolio profesional de Carlos Castañeda"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <SocialSidebar variant="mobile" />
    <SocialSidebar variant="desktop" />
    <main class="main-layout">
      <slot />
    </main>
  </body>
</html>

<style>
  html {
    scroll-behavior: smooth;
  }

  body {
    overflow-x: hidden;
  }

  .main-layout {
    width: 100%;
    min-height: 100vh;
    scroll-snap-type: y mandatory;
    overflow-y: auto;
    scroll-snap-points-y: repeat(100vh);
  }

  section {
    scroll-snap-align: start;
    min-height: 100vh;
    width: 100%;
  }
</style>
