---
import SocialSidebar from "../ui/social-sidebar.astro";
import Header from "../ui/header.astro";
import "../../styles/global.css";

interface Props {
  title: string;
  lang?: "es" | "en";
}

const { title, lang = "es" } = Astro.props;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Portfolio profesional de Carlos Castañeda"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("carloscn-theme");
        const preferred = window.matchMedia("(prefers-color-scheme: dark)")
          .matches
          ? "dark"
          : "light";
        const theme = stored || preferred;
        if (theme === "light") {
          document.documentElement.classList.remove("dark");
        } else {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body>
    <Header lang={lang} />
    <SocialSidebar variant="mobile" />
    <SocialSidebar variant="desktop" />
    <main class="main-layout">
      <slot />
    </main>
  </body>
</html>

<style>
  html {
    scroll-behavior: smooth;
  }

  body {
    overflow-x: hidden;
    padding-top: 4rem;
  }

  @media (min-width: 768px) {
    body {
      padding-top: 5rem;
    }
  }

  .main-layout {
    width: 100%;
    min-height: 100vh;
    scroll-snap-type: y mandatory;
    overflow-y: auto;
    scroll-snap-points-y: repeat(100vh);
  }

  section {
    scroll-snap-align: start;
    min-height: 100vh;
    width: 100%;
  }
</style>
