---
import BlogCard from "../ui/BlogCard.astro";
import BlogAccordionItem from "../ui/BlogAccordionItem.astro";
import LinkWrapper from "../ui/LinkWrapper.astro";
import ArrowNext from "../icons/ArrowNext.astro";
import type { StrapiMedia } from "../../types/strapi";

interface BlogPost {
  id: string;
  title: string;
  link: string;
  category: string;
  date: string;
  read_time: string;
  resume: string;
  featuredImage?: StrapiMedia;
}

interface BlogData {
  title: string;
  intro: string;
  view_more: string;
  posts: BlogPost[];
}

interface Props {
  es: BlogData;
  en: BlogData;
}

const { es, en } = Astro.props;
const data = es;
const posts = data.posts;

const embeddedData = { es, en };
const blogDataJson = JSON.stringify(embeddedData);
---

<section id="blog" class="blog-section">
  <script
    is:inline
    type="application/json"
    id="blog-data"
    set:html={blogDataJson}
  />

  <header class="blog-section__header">
    <h2 class="blog-section__title" data-i18n-content="section.blog">Blog</h2>
  </header>

  <p class="blog-section__intro" data-blog-intro>{data.intro}</p>

  <div class="blog-grid">
    {
      posts
        .slice(0, 6)
        .map((post) => (
          <BlogCard
            id={post.id}
            title={post.title}
            link={post.link}
            category={post.category}
            date={post.date}
            readTime={post.read_time}
            resume={post.resume}
            featuredImage={post.featuredImage}
          />
        ))
    }
  </div>

  <!-- Mobile Accordion (visible < 768px) -->
  <div class="blog-accordion" data-blog-accordion>
    {
      posts
        .slice(0, 6)
        .map((post) => (
          <BlogAccordionItem
            id={post.id}
            title={post.title}
            link={post.link}
            category={post.category}
            resume={post.resume}
          />
        ))
    }
  </div>

  {
    posts.length > 6 && (
      <div class="blog-section__view-more-wrapper">
        <LinkWrapper
          href="/posts"
          isExternal={false}
          class="blog-section__view-more"
          data-blog-viewmore
        >
          <span>{data.view_more}</span>
          <ArrowNext size="20" class="blog-section__view-more-icon" />
        </LinkWrapper>
      </div>
    )
  }
</section>

<script>
  import { initBlogLangSwitch, initBlogAccordion } from "../../utils/blog.ts";
  initBlogLangSwitch();
  initBlogAccordion();
</script>

<style>
  .blog-section {
    height: 100vh;
    overflow-y: auto;
    overflow-anchor: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: var(--spacing-lg);
  }

  .blog-section::-webkit-scrollbar {
    display: none;
  }

  .blog-section__header {
    margin-bottom: var(--spacing-md);
    text-align: left;
    width: 100%;
    align-self: flex-start;
  }

  .blog-section__title {
    font-family: var(--font-titles);
    font-size: var(--font-size-h2-mobile);
    font-weight: var(--weight-space-semibold);
    color: var(--text-base);
    margin-bottom: var(--spacing-md);
  }

  .blog-section__intro {
    font-family: var(--font-body);
    color: var(--text-base);
    line-height: 1.8;
    text-align: left;
    margin-bottom: var(--spacing-lg);
  }

  .blog-grid {
    display: none;
    gap: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    width: 100%;
    max-width: var(--max-width);
  }

  .blog-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    width: 100%;
  }

  @media (min-width: 480px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
      display: grid;
    }

    .blog-accordion {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .blog-section {
      padding: var(--spacing-lg) calc(var(--spacing-lg) * 2);
    }

    .blog-section__title {
      font-size: var(--font-size-h2-desktop);
    }

    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
      display: grid;
    }

    .blog-accordion {
      display: none;
    }
  }

  .blog-section__view-more-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
    padding-bottom: var(--spacing-lg);
  }

  :global(.blog-section__view-more) {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
    font-family: var(--font-titles);
    font-size: 0.9rem;
    color: var(--color-word);
    transition: color 300ms ease;
  }

  :global(.blog-section__view-more):hover {
    color: var(--color-accent);
  }

  :global(.blog-section__view-more-icon) {
    transition: transform 300ms ease;
  }

  :global(.blog-section__view-more):hover
    :global(.blog-section__view-more-icon) {
    transform: translateX(4px);
  }
</style>
