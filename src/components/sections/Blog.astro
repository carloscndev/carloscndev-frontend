---
import { Image } from "astro:assets";
import wallperImage from "../../assets/images/wallper.jpg";
import TechIcon from "../icons/TechIcon.astro";
import RunningIcon from "../icons/RunningIcon.astro";
import ExternalLink from "../icons/ExternalLink.astro";
import LinkWrapper from "../ui/LinkWrapper.astro";
import ArrowNext from "../icons/ArrowNext.astro";

interface BlogPost {
  id: string;
  title: string;
  link: string;
  icon: string;
  category: string;
  date: string;
  read_time: string;
  resume: string;
}

interface BlogData {
  title: string;
  intro: string;
  view_more: string;
  posts: BlogPost[];
}

interface Props {
  es: BlogData;
  en: BlogData;
}

const { es, en } = Astro.props;
const data = es;
const posts = data.posts;

const embeddedData = { es, en };
const blogDataJson = JSON.stringify(embeddedData);
---

<section id="blog" class="blog-section">
  <script
    is:inline
    type="application/json"
    id="blog-data"
    set:html={blogDataJson}
  />

  <header class="blog-section__header">
    <h2 class="blog-section__title" data-i18n-content="section.blog">Blog</h2>
  </header>

  <p class="blog-section__intro" data-blog-intro>{data.intro}</p>

  <div class="blog-grid">
    {
      posts.slice(0, 6).map((post) => (
        <LinkWrapper
          href={post.link}
          isExternal={false}
          class="blog-card"
          data-post-id={post.id}
          data-category-theme={post.icon === "tech-icon" ? "tech" : "running"}
          aria-label={post.title}
        >
          <div class="blog-card__image">
            <Image
              src={wallperImage}
              alt={post.title}
              class="blog-card__image-img"
              loading="lazy"
            />
            <div class="blog-card__overlay">
              <p class="blog-card__overlay-text">{post.resume || ""}</p>
            </div>
          </div>
          <ExternalLink size="18" class="blog-card__overlay-icon" />
          <div class="blog-card__content">
            <h3 class="blog-card__title" data-post-title>
              {post.title}
            </h3>
            <span class="blog-card__read-time" data-post-read-time>
              {post.read_time}
            </span>
            <div class="blog-card__meta">
              <span class="blog-card__date" data-post-date>
                {post.date}
              </span>
              <span class="blog-card__category" data-post-category>
                {post.category}
                {post.icon === "tech-icon" ? (
                  <TechIcon size="14" class="blog-card__category-icon" />
                ) : (
                  <RunningIcon size="14" class="blog-card__category-icon" />
                )}
              </span>
            </div>
          </div>
        </LinkWrapper>
      ))
    }
  </div>

  <!-- Mobile Accordion (visible < 768px) -->
  <div class="blog-accordion" data-blog-accordion>
    {
      posts.slice(0, 6).map((post) => (
        <div
          class="blog-accordion__item"
          data-accordion-item
          data-post-id={post.id}
          data-category-theme={post.icon === "tech-icon" ? "tech" : "running"}
        >
          <button
            class="blog-accordion__trigger"
            data-accordion-trigger
            aria-expanded="false"
            type="button"
          >
            {post.icon === "tech-icon" ? (
              <TechIcon size="20" class="blog-accordion__trigger-icon" />
            ) : (
              <RunningIcon size="20" class="blog-accordion__trigger-icon" />
            )}
            <h3 class="blog-accordion__trigger-title" data-post-title>
              {post.title}
            </h3>
            <LinkWrapper
              href={post.link}
              isExternal={false}
              class="blog-accordion__trigger-link"
              rel="noopener"
              aria-label="Open article"
            >
              <ExternalLink size="16" />
            </LinkWrapper>
            <svg
              class="blog-accordion__trigger-chevron"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
          <div class="blog-accordion__panel" data-accordion-panel>
            <p class="blog-accordion__panel-text" data-post-resume>
              {post.resume || ""}
            </p>
          </div>
        </div>
      ))
    }
  </div>

  {
    posts.length > 6 && (
      <div class="blog-section__view-more-wrapper">
        <LinkWrapper
          href="/posts"
          isExternal={false}
          class="blog-section__view-more"
          data-blog-viewmore
        >
          <span>{data.view_more}</span>
          <ArrowNext size="20" class="blog-section__view-more-icon" />
        </LinkWrapper>
      </div>
    )
  }
</section>

<script>
  import { initBlogLangSwitch, initBlogAccordion } from "../../utils/blog.ts";
  initBlogLangSwitch();
  initBlogAccordion();
</script>

<style>
  .blog-section {
    height: 100vh;
    overflow-y: auto;
    overflow-anchor: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: var(--spacing-lg);
  }

  .blog-section::-webkit-scrollbar {
    display: none;
  }

  .blog-section__header {
    margin-bottom: var(--spacing-md);
    text-align: left;
    width: 100%;
    align-self: flex-start;
  }

  .blog-section__title {
    font-family: var(--font-titles);
    font-size: var(--font-size-h2-mobile);
    font-weight: var(--weight-space-semibold);
    color: var(--text-base);
    margin-bottom: var(--spacing-md);
  }

  .blog-section__intro {
    font-family: var(--font-body);
    color: var(--text-base);
    line-height: 1.8;
    text-align: left;
    margin-bottom: var(--spacing-lg);
  }

  .blog-grid {
    display: none;
    gap: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    width: 100%;
    max-width: var(--max-width);
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--border-radius);
    background: var(--color-tech-primary-light);
    position: relative;
    transition:
      transform 300ms ease,
      box-shadow 300ms ease;
    overflow: hidden;
    text-decoration: none;
  }

  .blog-card[data-category-theme="tech"] {
    background: var(--color-tech-primary-light);
  }

  .blog-card[data-category-theme="running"] {
    background: var(--color-running-primary-light);
  }

  :global(.dark) .blog-card[data-category-theme="tech"] {
    background: var(--color-tech-primary-dark);
  }

  :global(.dark) .blog-card[data-category-theme="running"] {
    background: var(--color-running-primary-dark);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  :global(.dark) .blog-card:hover {
    box-shadow: var(--shadow-card-dark);
  }

  .blog-card__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    position: relative;
  }

  .blog-card__image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 300ms ease;
  }

  .blog-card:hover .blog-card__image-img {
    opacity: 0.2;
  }

  .blog-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: var(--spacing-md);
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .blog-card:hover .blog-card__overlay {
    opacity: 1;
  }

  :global(.blog-card__overlay-icon) {
    position: absolute;
    top: var(--spacing-sm);
    right: var(--spacing-sm);
    color: var(--text-base);
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .blog-card:hover :global(.blog-card__overlay-icon) {
    opacity: 1;
  }

  .blog-card__overlay-text {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--text-base);
    line-height: 1.5;
    text-align: center;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
  }

  .blog-card__content {
    padding: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .blog-card__title {
    font-family: var(--font-titles);
    font-size: var(--font-size-h3-mobile);
    font-weight: var(--weight-space-semibold);
    color: var(--text-base);
    line-height: 1.3;
  }

  .blog-card__category {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-titles);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-word);
  }

  :global(.blog-card__category-icon) {
    display: inline-block;
    flex-shrink: 0;
    color: inherit;
  }

  .blog-card__read-time {
    font-size: 0.8rem;
    color: var(--color-word);
    margin-bottom: 0.25rem;
  }

  .blog-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--color-word);
  }

  /* Category-themed text colors */
  .blog-card[data-category-theme="tech"] .blog-card__title,
  .blog-card[data-category-theme="tech"] .blog-card__read-time,
  .blog-card[data-category-theme="tech"] .blog-card__meta,
  .blog-card[data-category-theme="tech"] .blog-card__category {
    color: var(--color-tech-secondary-light);
  }

  .blog-card[data-category-theme="running"] .blog-card__title,
  .blog-card[data-category-theme="running"] .blog-card__read-time,
  .blog-card[data-category-theme="running"] .blog-card__meta,
  .blog-card[data-category-theme="running"] .blog-card__category {
    color: var(--color-running-secondary-light);
  }

  :global(.dark) .blog-card[data-category-theme="tech"] .blog-card__title,
  :global(.dark) .blog-card[data-category-theme="tech"] .blog-card__read-time,
  :global(.dark) .blog-card[data-category-theme="tech"] .blog-card__meta,
  :global(.dark) .blog-card[data-category-theme="tech"] .blog-card__category {
    color: var(--color-tech-secondary-dark);
  }

  :global(.dark) .blog-card[data-category-theme="running"] .blog-card__title,
  :global(.dark)
    .blog-card[data-category-theme="running"]
    .blog-card__read-time,
  :global(.dark) .blog-card[data-category-theme="running"] .blog-card__meta,
  :global(.dark)
    .blog-card[data-category-theme="running"]
    .blog-card__category {
    color: var(--color-running-secondary-dark);
  }

  /* Mobile Accordion (visible < 768px) */
  .blog-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    width: 100%;
  }

  .blog-accordion__item {
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .blog-accordion__item[data-category-theme="tech"] {
    background: var(--color-tech-primary-light);
  }

  .blog-accordion__item[data-category-theme="running"] {
    background: var(--color-running-primary-light);
  }

  :global(.dark) .blog-accordion__item[data-category-theme="tech"] {
    background: var(--color-tech-primary-dark);
  }

  :global(.dark) .blog-accordion__item[data-category-theme="running"] {
    background: var(--color-running-primary-dark);
  }

  .blog-accordion__trigger {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    width: 100%;
    padding: var(--spacing-md);
    background: none;
    border: none;
    color: var(--text-base);
    font-family: var(--font-titles);
    font-size: var(--font-size-h3-mobile);
    font-weight: var(--weight-space-medium);
    cursor: pointer;
    text-align: left;
  }

  .blog-accordion__trigger-title {
    flex: 1;
    color: inherit;
  }

  .blog-accordion__item[data-category-theme="tech"]
    .blog-accordion__trigger-title {
    color: var(--color-tech-secondary-light);
  }

  .blog-accordion__item[data-category-theme="running"]
    .blog-accordion__trigger-title {
    color: var(--color-running-secondary-light);
  }

  :global(.dark)
    .blog-accordion__item[data-category-theme="tech"]
    .blog-accordion__trigger-title {
    color: var(--color-tech-secondary-dark);
  }

  :global(.dark)
    .blog-accordion__item[data-category-theme="running"]
    .blog-accordion__trigger-title {
    color: var(--color-running-secondary-dark);
  }

  :global(.blog-accordion__trigger-icon) {
    flex-shrink: 0;
    margin-top: 0.3rem;
  }

  .blog-accordion__item[data-category-theme="tech"]
    :global(.blog-accordion__trigger-icon) {
    color: var(--color-tech-secondary-light);
  }

  .blog-accordion__item[data-category-theme="running"]
    :global(.blog-accordion__trigger-icon) {
    color: var(--color-running-secondary-light);
  }

  :global(.dark)
    .blog-accordion__item[data-category-theme="tech"]
    :global(.blog-accordion__trigger-icon) {
    color: var(--color-tech-secondary-dark);
  }

  :global(.dark)
    .blog-accordion__item[data-category-theme="running"]
    :global(.blog-accordion__trigger-icon) {
    color: var(--color-running-secondary-dark);
  }

  .blog-accordion__trigger-link {
    display: inline-flex;
    align-items: flex-start;
    flex-shrink: 0;
    margin-top: 0.3rem;
  }

  .blog-accordion__item[data-category-theme="tech"]
    .blog-accordion__trigger-link {
    color: var(--color-tech-secondary-light);
  }

  .blog-accordion__item[data-category-theme="running"]
    .blog-accordion__trigger-link {
    color: var(--color-running-secondary-light);
  }

  :global(.dark)
    .blog-accordion__item[data-category-theme="tech"]
    .blog-accordion__trigger-link {
    color: var(--color-tech-secondary-dark);
  }

  :global(.dark)
    .blog-accordion__item[data-category-theme="running"]
    .blog-accordion__trigger-link {
    color: var(--color-running-secondary-dark);
  }

  .blog-accordion__trigger-link:hover {
    color: var(--color-accent);
  }

  .blog-accordion__trigger-chevron {
    flex-shrink: 0;
    margin-top: 0.3rem;
    transition: transform 300ms ease;
  }

  .blog-accordion__item[data-category-theme="tech"]
    .blog-accordion__trigger-chevron {
    color: var(--color-tech-secondary-light);
  }

  .blog-accordion__item[data-category-theme="running"]
    .blog-accordion__trigger-chevron {
    color: var(--color-running-secondary-light);
  }

  :global(.dark)
    .blog-accordion__item[data-category-theme="tech"]
    .blog-accordion__trigger-chevron {
    color: var(--color-tech-secondary-dark);
  }

  :global(.dark)
    .blog-accordion__item[data-category-theme="running"]
    .blog-accordion__trigger-chevron {
    color: var(--color-running-secondary-dark);
  }

  .blog-accordion__trigger[aria-expanded="true"]
    .blog-accordion__trigger-chevron {
    transform: rotate(180deg);
  }

  .blog-accordion__panel {
    max-height: 0;
    overflow: hidden;
    transition:
      max-height 350ms ease,
      padding 350ms ease;
    padding: 0 var(--spacing-md);
  }

  .blog-accordion__panel--open {
    max-height: 300px;
    padding: 1rem var(--spacing-md) var(--spacing-md);
  }

  .blog-accordion__panel-text {
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    color: var(--text-base);
    line-height: 1.6;
  }

  @media (min-width: 480px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
      display: grid;
    }

    .blog-accordion {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .blog-section {
      padding: var(--spacing-lg) calc(var(--spacing-lg) * 2);
    }

    .blog-section__title {
      font-size: var(--font-size-h2-desktop);
    }

    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
      display: grid;
    }

    .blog-accordion {
      display: none;
    }

    .blog-card__title {
      font-size: var(--font-size-h3-desktop);
    }
  }

  .blog-section__view-more-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
    padding-bottom: var(--spacing-lg);
  }

  :global(.blog-section__view-more) {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-xs);
    font-family: var(--font-titles);
    font-size: 0.9rem;
    color: var(--color-word);
    transition: color 300ms ease;
  }

  :global(.blog-section__view-more):hover {
    color: var(--color-accent);
  }

  :global(.blog-section__view-more-icon) {
    transition: transform 300ms ease;
  }

  :global(.blog-section__view-more):hover
    :global(.blog-section__view-more-icon) {
    transform: translateX(4px);
  }
</style>
