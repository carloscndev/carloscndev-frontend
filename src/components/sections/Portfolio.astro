---
import Diamond from "../icons/Diamond.astro";
import TechPill from "../ui/TechPill.astro";
import GithubIcon from "../icons/GithubIcon.astro";
import ExternalLink from "../icons/ExternalLink.astro";
import FileIcon from "../icons/FileIcon.astro";
import ArrowNext from "../icons/ArrowNext.astro";
import LinkWrapper from "../ui/LinkWrapper.astro";

interface ProjectLink {
  repo?: string;
  demo?: string;
  article?: string;
}

interface Project {
  id: string;
  title: string;
  description: string;
  technologies: string[];
  links: ProjectLink;
  coverImage?: {
    url: string;
    alternativeText?: string;
    formats?: {
      small?: { url: string };
      medium?: { url: string };
      large?: { url: string };
    };
  };
}

interface PortfolioData {
  title: string;
  intro: string;
  view_more: string;
  projects: Project[];
}

interface Props {
  es: PortfolioData;
  en: PortfolioData;
}

const { es, en } = Astro.props;
const data = es;

const embeddedData = { es, en };
const embeddedDataJson = JSON.stringify(embeddedData);
---

<section id="portfolio" class="portfolio-section">
  <script
    is:inline
    type="application/json"
    id="portfolio-data"
    set:html={embeddedDataJson}
  />

  <header class="portfolio-section__header">
    <h2
      class="portfolio-section__title"
      data-portfolio-title
      data-i18n-content="section.portfolio"
    >
      {data.title}
    </h2>
    <p class="portfolio-section__intro" data-portfolio-intro>{data.intro}</p>
  </header>

  <!-- Desktop Grid (visible >= 480px) -->
  <div class="portfolio-grid" data-portfolio-grid>
    {
      data.projects.slice(0, 6).map((project) => (
        <div class="portfolio-grid__card" data-project-id={project.id}>
          <div class="portfolio-card__header">
            <Diamond size="22" class="portfolio-card__diamond" />
            <div class="portfolio-card__links" data-project-links>
              {project.links.repo && (
                <LinkWrapper
                  href={project.links.repo}
                  class="portfolio-card__link"
                  aria-label="Repository"
                >
                  <GithubIcon size="18" />
                </LinkWrapper>
              )}
              {project.links.demo && (
                <LinkWrapper
                  href={project.links.demo}
                  class="portfolio-card__link"
                  aria-label="Demo"
                >
                  <ExternalLink size="18" />
                </LinkWrapper>
              )}
              {project.links.article && (
                <LinkWrapper
                  href={project.links.article}
                  class="portfolio-card__link"
                  aria-label="Article"
                >
                  <FileIcon size="18" />
                </LinkWrapper>
              )}
            </div>
          </div>
          <h3 class="portfolio-card__title" data-project-title>
            {project.title}
          </h3>
          <p class="portfolio-card__description" data-project-description>
            {project.description}
          </p>
          <div class="portfolio-card__tags" data-project-tags>
            {project.technologies.map((tech: string) => (
              <TechPill label={tech} variant="card" />
            ))}
          </div>
          <button
            class="portfolio-card__view-more"
            data-project-view-more
            data-project-title={project.title}
            data-project-description={project.description}
            data-project-technologies={project.technologies.join(",")}
            data-project-links-repo={project.links.repo || ""}
            data-project-links-demo={project.links.demo || ""}
            data-project-links-article={project.links.article || ""}
            data-project-cover-image={project.coverImage?.url || ""}
            type="button"
          >
            <span data-i18n="portfolio.view_more">Ver más</span>
          </button>
        </div>
      ))
    }
  </div>

  <!-- Mobile Accordion (visible < 480px) -->
  <div class="portfolio-accordion" data-portfolio-accordion>
    {
      data.projects.slice(0, 6).map((project) => (
        <div
          class="portfolio-accordion__item"
          data-accordion-item
          data-project-id={project.id}
        >
          <button
            class="portfolio-accordion__trigger"
            data-accordion-trigger
            aria-expanded="false"
            type="button"
          >
            <Diamond size="22" class="portfolio-accordion__diamond" />
            <span class="portfolio-accordion__title" data-project-title>
              {project.title}
            </span>
            <svg
              class="portfolio-accordion__chevron"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
          <div class="portfolio-accordion__panel" data-accordion-panel>
            <p
              class="portfolio-accordion__description"
              data-project-description
            >
              {project.description}
            </p>
            <div class="portfolio-accordion__tags" data-project-tags>
              {project.technologies.map((tech: string) => (
                <TechPill label={tech} variant="card" />
              ))}
            </div>
            <div class="portfolio-accordion__footer">
              <button
                class="portfolio-accordion__view-more"
                data-project-view-more
                data-project-title={project.title}
                data-project-description={project.description}
                data-project-technologies={project.technologies.join(",")}
                data-project-links-repo={project.links.repo || ""}
                data-project-links-demo={project.links.demo || ""}
                data-project-links-article={project.links.article || ""}
                data-project-cover-image={project.coverImage?.url || ""}
                type="button"
              >
                <span data-i18n="portfolio.view_more">Ver más</span>
              </button>
              <div class="portfolio-accordion__links" data-project-links>
                {project.links.repo && (
                  <LinkWrapper
                    href={project.links.repo}
                    class="portfolio-accordion__link"
                    aria-label="Repository"
                  >
                    <GithubIcon size="16" />
                  </LinkWrapper>
                )}
                {project.links.demo && (
                  <LinkWrapper
                    href={project.links.demo}
                    class="portfolio-accordion__link"
                    aria-label="Demo"
                  >
                    <ExternalLink size="16" />
                  </LinkWrapper>
                )}
                {project.links.article && (
                  <LinkWrapper
                    href={project.links.article}
                    class="portfolio-accordion__link"
                    aria-label="Article"
                  >
                    <FileIcon size="16" />
                  </LinkWrapper>
                )}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  {
    data.projects.length > 6 && (
      <div class="portfolio-section__view-more-wrapper">
        <LinkWrapper
          href="/projects"
          isExternal={false}
          class="portfolio-section__view-more"
          data-portfolio-viewmore
        >
          <span>{data.view_more}</span>
          <ArrowNext size="20" class="portfolio-section__view-more-icon" />
        </LinkWrapper>
      </div>
    )
  }

  <!-- Project Detail Modal -->
  <div
    class="portfolio-modal"
    id="portfolio-modal"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
  >
    <div class="portfolio-modal__overlay" data-modal-close></div>
    <div class="portfolio-modal__content">
      <button
        class="portfolio-modal__close"
        data-modal-close
        aria-label="Close"
      >
        <svg
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
      <h2 class="portfolio-modal__title" data-modal-title></h2>
      <div class="portfolio-modal__image-container">
        <img class="portfolio-modal__image" data-modal-image src="" alt="" />
      </div>
      <p class="portfolio-modal__description" data-modal-description></p>
      <div class="portfolio-modal__tags" data-modal-tags></div>
      <div class="portfolio-modal__links" data-modal-links></div>
    </div>
  </div>
</section>

<script>
  import {
    initPortfolioLangSwitch,
    initPortfolioAccordion,
  } from "../../utils/portfolio.ts";
  import { getStrapiMediaUrl } from "../../services/strapi.ts";

  initPortfolioLangSwitch();
  initPortfolioAccordion();

  const modal = document.getElementById("portfolio-modal");
  const modalTitle = document.querySelector("[data-modal-title]");
  const modalImage = document.querySelector(
    "[data-modal-image]",
  ) as HTMLImageElement;
  const modalDescription = document.querySelector("[data-modal-description]");
  const modalTags = document.querySelector("[data-modal-tags]");
  const modalLinks = document.querySelector("[data-modal-links]");

  function openModal(projectData: {
    title: string;
    description: string;
    technologies: string[];
    coverImage: string;
    links: { repo?: string; demo?: string; article?: string };
  }) {
    if (!modal) return;

    if (modalTitle) modalTitle.textContent = projectData.title;
    if (modalDescription)
      modalDescription.textContent = projectData.description;

    if (modalImage) {
      if (projectData.coverImage) {
        modalImage.src = getStrapiMediaUrl(projectData.coverImage);
        modalImage.alt = projectData.title;
        modalImage.style.display = "block";
      } else {
        modalImage.style.display = "none";
      }
    }

    if (modalTags) {
      modalTags.innerHTML = projectData.technologies
        .map((t) => `<span class="tech-pill tech-pill--card">${t}</span>`)
        .join("");
    }

    if (modalLinks) {
      modalLinks.innerHTML = "";
      if (projectData.links.repo) {
        modalLinks.innerHTML += `<a href="${projectData.links.repo}" target="_blank" rel="noopener" class="portfolio-modal__link">Repository</a>`;
      }
      if (projectData.links.demo) {
        modalLinks.innerHTML += `<a href="${projectData.links.demo}" target="_blank" rel="noopener" class="portfolio-modal__link">Demo</a>`;
      }
      if (projectData.links.article) {
        modalLinks.innerHTML += `<a href="${projectData.links.article}" target="_blank" rel="noopener" class="portfolio-modal__link">Article</a>`;
      }
    }

    modal.classList.add("portfolio-modal--open");
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove("portfolio-modal--open");
    modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  document.querySelectorAll("[data-project-view-more]").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const target = e.currentTarget as HTMLElement;
      const projectData = {
        title: target.dataset.projectTitle || "",
        description: target.dataset.projectDescription || "",
        technologies: (target.dataset.projectTechnologies || "")
          .split(",")
          .filter(Boolean),
        coverImage: target.dataset.projectCoverImage || "",
        links: {
          repo: target.dataset.projectLinksRepo || undefined,
          demo: target.dataset.projectLinksDemo || undefined,
          article: target.dataset.projectLinksArticle || undefined,
        },
      };
      openModal(projectData);
    });
  });

  document.querySelectorAll("[data-modal-close]").forEach((closeBtn) => {
    closeBtn.addEventListener("click", closeModal);
  });

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    if (
      e.key === "Escape" &&
      modal?.classList.contains("portfolio-modal--open")
    ) {
      closeModal();
    }
  });
</script>

<style>
  .portfolio-section {
    height: 100vh;
    overflow-y: auto;
    overflow-anchor: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: var(--spacing-lg);
  }

  .portfolio-section::-webkit-scrollbar {
    display: none;
  }

  .portfolio-section__header {
    margin-bottom: var(--spacing-lg);
    text-align: left;
    width: 100%;
    align-self: flex-start;
  }

  .portfolio-section__title {
    font-family: var(--font-titles);
    font-size: var(--font-size-h2-mobile);
    font-weight: var(--weight-space-semibold);
    color: var(--text-base);
    margin-bottom: var(--spacing-md);
  }

  .portfolio-section__intro {
    font-family: var(--font-body);
    color: var(--text-base);
    line-height: 1.8;
  }

  /* Desktop Grid (hidden on mobile) */
  .portfolio-grid {
    display: none;
  }

  /* Mobile Accordion (visible on mobile) */
  .portfolio-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .portfolio-accordion__item {
    border-radius: var(--border-radius);
    overflow: hidden;
    background: var(--color-tech-primary-light);
  }

  .portfolio-accordion__panel {
    max-height: 0;
    overflow: hidden;
    transition:
      max-height 350ms ease,
      padding 350ms ease;
    padding: 0 var(--spacing-md);
  }

  .portfolio-accordion__panel--open {
    max-height: 600px;
    padding: 1rem var(--spacing-md) var(--spacing-md);
  }

  :global(.dark) .portfolio-accordion__item {
    background: var(--color-tech-primary-dark);
  }

  .portfolio-accordion__trigger {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    width: 100%;
    padding: var(--spacing-md);
    background: none;
    border: none;
    color: var(--text-base);
    font-family: var(--font-titles);
    font-size: var(--font-size-h3-mobile);
    font-weight: var(--weight-space-medium);
    cursor: pointer;
    text-align: left;
    transition: background-color 200ms ease;
  }

  .portfolio-accordion__trigger:hover {
    background: rgba(51, 31, 232, 0.05);
  }

  .portfolio-accordion__trigger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--border-radius);
  }

  .portfolio-accordion__trigger[aria-expanded="true"] {
    background: rgba(51, 31, 232, 0.08);
  }

  :global(.portfolio-accordion__diamond) {
    color: var(--color-word);
    flex-shrink: 0;
  }

  .portfolio-accordion__title {
    flex: 1;
    color: var(--color-accent);
  }

  .portfolio-accordion__chevron {
    flex-shrink: 0;
    color: var(--color-word);
    transition: transform 300ms ease;
  }

  .portfolio-accordion__trigger[aria-expanded="true"]
    .portfolio-accordion__chevron {
    transform: rotate(180deg);
  }

  .portfolio-accordion__panel {
    max-height: 0;
    overflow: hidden;
    transition:
      max-height 350ms ease,
      padding 350ms ease;
    padding: 0 var(--spacing-md);
  }

  .portfolio-accordion__panel--open {
    max-height: 600px;
    padding: 1rem var(--spacing-md) var(--spacing-md);
  }

  .portfolio-accordion__description {
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    color: var(--text-base);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .portfolio-accordion__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-sm);
  }

  .portfolio-accordion__links {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: flex-end;
  }

  .portfolio-accordion__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--spacing-sm);
  }

  :global(.portfolio-accordion__link) {
    color: var(--color-word);
    transition: color 300ms ease;
    display: inline-flex;
    align-items: center;
  }

  :global(.portfolio-accordion__link):hover {
    color: var(--color-accent);
  }

  :global(.portfolio-accordion__link):focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .portfolio-accordion__view-more {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-family: var(--font-titles);
    font-size: 0.8rem;
    font-weight: var(--weight-space-medium);
    color: var(--color-accent);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color 300ms ease;
  }

  .portfolio-accordion__view-more:hover {
    color: var(--color-word);
  }

  /* View More */
  .portfolio-section__view-more-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: var(--spacing-lg) auto 0;
    color: var(--color-word);
    cursor: pointer;
    transition: color 300ms ease;
  }

  .portfolio-section__view-more-wrapper:hover {
    color: var(--color-accent);
  }

  :global(.portfolio-section__view-more) {
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: var(--weight-inter-medium);
    text-align: center;
    color: inherit;
    flex-direction: column;
    align-items: center;
  }

  :global(.portfolio-section__view-more-icon) {
    display: block;
    margin-top: var(--spacing-xs);
    color: inherit;
  }

  /* Desktop grid: visible >= 480px, accordion hidden */
  @media (min-width: 480px) {
    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-md);
      padding-bottom: var(--spacing-lg);
    }

    .portfolio-accordion {
      display: none;
    }
  }

  /* Desktop card styles */
  .portfolio-grid__card {
    display: flex;
    flex-direction: column;
    border-radius: var(--border-radius);
    background: var(--color-tech-primary-light);
    padding: var(--spacing-md);
    padding-bottom: calc(var(--spacing-md) + 30px);
    transition:
      transform 300ms ease,
      box-shadow 300ms ease;
    position: relative;
  }

  .portfolio-grid__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  :global(.dark) .portfolio-grid__card {
    background: var(--color-tech-primary-dark);
  }

  :global(.dark) .portfolio-grid__card:hover {
    box-shadow: var(--shadow-card-dark);
  }

  :global(.dark) .portfolio-grid__card:hover {
    box-shadow: var(--shadow-card-dark);
  }

  .portfolio-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-sm);
  }

  :global(.portfolio-card__diamond) {
    color: var(--color-word);
  }

  .portfolio-card__title {
    font-family: var(--font-titles);
    font-size: var(--font-size-h3-mobile);
    font-weight: var(--weight-space-semibold);
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .portfolio-card__description {
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    color: var(--text-base);
    line-height: 1.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .portfolio-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-sm);
  }

  .portfolio-card__view-more {
    position: absolute;
    bottom: var(--spacing-md);
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-family: var(--font-titles);
    font-size: var(--font-size-body-mobile);
    font-weight: var(--weight-space-medium);
    color: var(--color-accent);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition:
      color 300ms ease,
      transform 200ms ease;
    white-space: nowrap;
  }

  .portfolio-card__view-more:hover {
    color: var(--color-word);
    transform: translateX(-50%) translateY(-2px);
  }

  .portfolio-card__links {
    display: flex;
    gap: var(--spacing-sm);
  }

  :global(.portfolio-card__link) {
    color: var(--color-word);
    transition:
      color 300ms ease,
      transform 200ms ease;
    display: inline-flex;
    align-items: center;
  }

  :global(.portfolio-card__link):hover {
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  :global(.portfolio-card__link):focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Prevent Safari icon flicker during theme transitions */
  :global(.portfolio-card__link svg),
  :global(.portfolio-card__link path),
  :global(.portfolio-accordion__link svg),
  :global(.portfolio-accordion__link path),
  :global(.portfolio-card__diamond),
  :global(.portfolio-card__diamond path),
  :global(.portfolio-accordion__diamond),
  :global(.portfolio-accordion__diamond path) {
    transition: none;
  }

  /* 3-column grid at 768px */
  @media (min-width: 768px) {
    .portfolio-section {
      padding: var(--spacing-lg) calc(var(--spacing-lg) * 3);
    }

    .portfolio-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .portfolio-section__title {
      font-size: var(--font-size-h2-desktop);
    }

    .portfolio-section__intro {
      font-size: var(--font-size-body-desktop);
    }

    .portfolio-card__title {
      font-size: var(--font-size-h3-desktop);
    }

    .portfolio-card__description {
      font-size: var(--font-size-body-desktop);
    }

    .portfolio-card__view-more {
      font-size: var(--font-size-body-desktop);
    }

    :global(.portfolio-section__view-more) {
      font-size: var(--font-size-body-desktop);
      flex-direction: column;
    }
  }

  /* Project Modal Styles */
  .portfolio-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    justify-content: center;
    align-items: center;
    padding: var(--spacing-lg);
  }

  .portfolio-modal--open {
    display: flex;
  }

  .portfolio-modal__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
  }

  .portfolio-modal__content {
    position: relative;
    background: var(--bg-primary);
    border-radius: var(--spacing-md);
    padding: var(--spacing-lg);
    max-width: 600px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .portfolio-modal__close {
    position: absolute;
    top: var(--spacing-sm);
    right: var(--spacing-sm);
    background: none;
    border: none;
    color: var(--color-word);
    cursor: pointer;
    padding: var(--spacing-xs);
    transition: color 200ms ease;
  }

  .portfolio-modal__close:hover {
    color: var(--color-accent);
  }

  .portfolio-modal__title {
    font-family: var(--font-titles);
    font-size: 1.5rem;
    color: var(--text-base);
    text-align: center;
    margin: 0;
  }

  .portfolio-modal__image-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--spacing-sm);
    overflow: hidden;
  }

  .portfolio-modal__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
