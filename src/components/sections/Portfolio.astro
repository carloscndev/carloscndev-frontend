---
import Diamond from "../icons/Diamond.astro";
import TechPill from "../ui/TechPill.astro";
import GithubIcon from "../icons/GithubIcon.astro";
import ExternalLink from "../icons/ExternalLink.astro";
import FileIcon from "../icons/FileIcon.astro";
import ArrowNext from "../icons/ArrowNext.astro";
import LinkWrapper from "../ui/LinkWrapper.astro";

interface ProjectLink {
  repo?: string;
  demo?: string;
  article?: string;
}

interface Project {
  id: string;
  title: string;
  description: string;
  technologies: string[];
  links: ProjectLink;
}

interface PortfolioData {
  title: string;
  intro: string;
  view_more: string;
  projects: Project[];
}

interface Props {
  es: PortfolioData;
  en: PortfolioData;
}

const { es, en } = Astro.props;
const data = es;

const embeddedData = { es, en };
const embeddedDataJson = JSON.stringify(embeddedData);
---

<section id="portfolio" class="portfolio-section">
  <script
    is:inline
    type="application/json"
    id="portfolio-data"
    set:html={embeddedDataJson}
  />

  <header class="portfolio-section__header">
    <h2
      class="portfolio-section__title"
      data-portfolio-title
      data-i18n-content="section.portfolio"
    >
      {data.title}
    </h2>
    <p class="portfolio-section__intro" data-portfolio-intro>{data.intro}</p>
  </header>

  <!-- Desktop Grid (visible >= 480px) -->
  <div class="portfolio-grid" data-portfolio-grid>
    {
      data.projects.slice(0, 6).map((project) => (
        <div class="portfolio-grid__card" data-project-id={project.id}>
          <div class="portfolio-card__header">
            <Diamond size="22" class="portfolio-card__diamond" />
            <div class="portfolio-card__links" data-project-links>
              {project.links.repo && (
                <LinkWrapper
                  href={project.links.repo}
                  class="portfolio-card__link"
                  aria-label="Repository"
                >
                  <GithubIcon size="18" />
                </LinkWrapper>
              )}
              {project.links.demo && (
                <LinkWrapper
                  href={project.links.demo}
                  class="portfolio-card__link"
                  aria-label="Demo"
                >
                  <ExternalLink size="18" />
                </LinkWrapper>
              )}
              {project.links.article && (
                <LinkWrapper
                  href={project.links.article}
                  class="portfolio-card__link"
                  aria-label="Article"
                >
                  <FileIcon size="18" />
                </LinkWrapper>
              )}
            </div>
          </div>
          <h3 class="portfolio-card__title" data-project-title>
            {project.title}
          </h3>
          <p class="portfolio-card__description" data-project-description>
            {project.description}
          </p>
          <div class="portfolio-card__tags" data-project-tags>
            {project.technologies.map((tech: string) => (
              <TechPill label={tech} variant="card" />
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <!-- Mobile Accordion (visible < 480px) -->
  <div class="portfolio-accordion" data-portfolio-accordion>
    {
      data.projects.slice(0, 6).map((project) => (
        <div
          class="portfolio-accordion__item"
          data-accordion-item
          data-project-id={project.id}
        >
          <button
            class="portfolio-accordion__trigger"
            data-accordion-trigger
            aria-expanded="false"
            type="button"
          >
            <Diamond size="22" class="portfolio-accordion__diamond" />
            <span class="portfolio-accordion__title" data-project-title>
              {project.title}
            </span>
            <svg
              class="portfolio-accordion__chevron"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
          <div class="portfolio-accordion__panel" data-accordion-panel>
            <p
              class="portfolio-accordion__description"
              data-project-description
            >
              {project.description}
            </p>
            <div class="portfolio-accordion__tags" data-project-tags>
              {project.technologies.map((tech: string) => (
                <TechPill label={tech} variant="card" />
              ))}
            </div>
            <div class="portfolio-accordion__links" data-project-links>
              {project.links.repo && (
                <LinkWrapper
                  href={project.links.repo}
                  class="portfolio-accordion__link"
                  aria-label="Repository"
                >
                  <GithubIcon size="16" />
                </LinkWrapper>
              )}
              {project.links.demo && (
                <LinkWrapper
                  href={project.links.demo}
                  class="portfolio-accordion__link"
                  aria-label="Demo"
                >
                  <ExternalLink size="16" />
                </LinkWrapper>
              )}
              {project.links.article && (
                <LinkWrapper
                  href={project.links.article}
                  class="portfolio-accordion__link"
                  aria-label="Article"
                >
                  <FileIcon size="16" />
                </LinkWrapper>
              )}
            </div>
          </div>
        </div>
      ))
    }
  </div>

  {
    data.projects.length > 6 && (
      <div class="portfolio-section__view-more-wrapper">
        <LinkWrapper
          href="/projects"
          isExternal={false}
          class="portfolio-section__view-more"
          data-portfolio-viewmore
        >
          <span>{data.view_more}</span>
          <ArrowNext size="20" class="portfolio-section__view-more-icon" />
        </LinkWrapper>
      </div>
    )
  }
</section>

<script>
  import {
    initPortfolioLangSwitch,
    initPortfolioAccordion,
  } from "../../utils/portfolio.ts";
  initPortfolioLangSwitch();
  initPortfolioAccordion();
</script>

<style>
  .portfolio-section {
    height: 100vh;
    overflow-y: auto;
    overflow-anchor: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: var(--spacing-lg);
  }

  .portfolio-section::-webkit-scrollbar {
    display: none;
  }

  .portfolio-section__header {
    margin-bottom: var(--spacing-lg);
    text-align: left;
    width: 100%;
    align-self: flex-start;
  }

  .portfolio-section__title {
    font-family: var(--font-titles);
    font-size: var(--font-size-h2-mobile);
    font-weight: var(--weight-space-semibold);
    color: var(--text-base);
    margin-bottom: var(--spacing-md);
  }

  .portfolio-section__intro {
    font-family: var(--font-body);
    color: var(--text-base);
    line-height: 1.8;
  }

  /* Desktop Grid (hidden on mobile) */
  .portfolio-grid {
    display: none;
  }

  /* Mobile Accordion (visible on mobile) */
  .portfolio-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .portfolio-accordion__item {
    border-radius: var(--border-radius);
    overflow: hidden;
    background: var(--color-tech-primary-light);
  }

  .portfolio-accordion__panel {
    max-height: 0;
    overflow: hidden;
    transition:
      max-height 350ms ease,
      padding 350ms ease;
    padding: 0 var(--spacing-md);
  }

  .portfolio-accordion__panel--open {
    max-height: 600px;
    padding: 1rem var(--spacing-md) var(--spacing-md);
  }

  :global(.dark) .portfolio-accordion__item {
    background: var(--color-tech-primary-dark);
  }

  .portfolio-accordion__trigger {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    width: 100%;
    padding: var(--spacing-md);
    background: none;
    border: none;
    color: var(--text-base);
    font-family: var(--font-titles);
    font-size: var(--font-size-h3-mobile);
    font-weight: var(--weight-space-medium);
    cursor: pointer;
    text-align: left;
    transition: background-color 200ms ease;
  }

  .portfolio-accordion__trigger:hover {
    background: rgba(51, 31, 232, 0.05);
  }

  .portfolio-accordion__trigger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--border-radius);
  }

  .portfolio-accordion__trigger[aria-expanded="true"] {
    background: rgba(51, 31, 232, 0.08);
  }

  :global(.portfolio-accordion__diamond) {
    color: var(--color-word);
    flex-shrink: 0;
  }

  .portfolio-accordion__title {
    flex: 1;
    color: var(--color-accent);
  }

  .portfolio-accordion__chevron {
    flex-shrink: 0;
    color: var(--color-word);
    transition: transform 300ms ease;
  }

  .portfolio-accordion__trigger[aria-expanded="true"]
    .portfolio-accordion__chevron {
    transform: rotate(180deg);
  }

  .portfolio-accordion__panel {
    max-height: 0;
    overflow: hidden;
    transition:
      max-height 350ms ease,
      padding 350ms ease;
    padding: 0 var(--spacing-md);
  }

  .portfolio-accordion__panel--open {
    max-height: 600px;
    padding: 1rem var(--spacing-md) var(--spacing-md);
  }

  .portfolio-accordion__description {
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    color: var(--text-base);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .portfolio-accordion__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-sm);
  }

  .portfolio-accordion__links {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: flex-end;
  }

  :global(.portfolio-accordion__link) {
    color: var(--color-word);
    transition: color 300ms ease;
    display: inline-flex;
    align-items: center;
  }

  :global(.portfolio-accordion__link):hover {
    color: var(--color-accent);
  }

  :global(.portfolio-accordion__link):focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* View More */
  .portfolio-section__view-more-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: var(--spacing-lg) auto 0;
    color: var(--color-word);
    cursor: pointer;
    transition: color 300ms ease;
  }

  .portfolio-section__view-more-wrapper:hover {
    color: var(--color-accent);
  }

  :global(.portfolio-section__view-more) {
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: var(--weight-inter-medium);
    text-align: center;
    color: inherit;
    flex-direction: column;
    align-items: center;
  }

  :global(.portfolio-section__view-more-icon) {
    display: block;
    margin-top: var(--spacing-xs);
    color: inherit;
  }

  /* Desktop grid: visible >= 480px, accordion hidden */
  @media (min-width: 480px) {
    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-md);
      padding-bottom: var(--spacing-lg);
    }

    .portfolio-accordion {
      display: none;
    }
  }

  /* Desktop card styles */
  .portfolio-grid__card {
    display: flex;
    flex-direction: column;
    border-radius: var(--border-radius);
    background: var(--color-tech-primary-light);
    padding: var(--spacing-md);
    transition:
      transform 300ms ease,
      box-shadow 300ms ease;
  }

  .portfolio-grid__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  :global(.dark) .portfolio-grid__card {
    background: var(--color-tech-primary-dark);
  }

  :global(.dark) .portfolio-grid__card:hover {
    box-shadow: var(--shadow-card-dark);
  }

  :global(.dark) .portfolio-grid__card:hover {
    box-shadow: var(--shadow-card-dark);
  }

  .portfolio-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-sm);
  }

  :global(.portfolio-card__diamond) {
    color: var(--color-word);
  }

  .portfolio-card__title {
    font-family: var(--font-titles);
    font-size: var(--font-size-h3-mobile);
    font-weight: var(--weight-space-semibold);
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .portfolio-card__description {
    font-family: var(--font-body);
    font-size: var(--font-size-body-mobile);
    color: var(--text-base);
    line-height: 1.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .portfolio-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-sm);
  }

  .portfolio-card__links {
    display: flex;
    gap: var(--spacing-sm);
  }

  :global(.portfolio-card__link) {
    color: var(--color-word);
    transition:
      color 300ms ease,
      transform 200ms ease;
    display: inline-flex;
    align-items: center;
  }

  :global(.portfolio-card__link):hover {
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  :global(.portfolio-card__link):focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Prevent Safari icon flicker during theme transitions */
  :global(.portfolio-card__link svg),
  :global(.portfolio-card__link path),
  :global(.portfolio-accordion__link svg),
  :global(.portfolio-accordion__link path),
  :global(.portfolio-card__diamond),
  :global(.portfolio-card__diamond path),
  :global(.portfolio-accordion__diamond),
  :global(.portfolio-accordion__diamond path) {
    transition: none;
  }

  /* 3-column grid at 768px */
  @media (min-width: 768px) {
    .portfolio-section {
      padding: var(--spacing-lg) calc(var(--spacing-lg) * 3);
    }

    .portfolio-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .portfolio-section__title {
      font-size: var(--font-size-h2-desktop);
    }

    .portfolio-section__intro {
      font-size: var(--font-size-body-desktop);
    }

    .portfolio-card__title {
      font-size: var(--font-size-h3-desktop);
    }

    .portfolio-card__description {
      font-size: var(--font-size-body-desktop);
    }

    :global(.portfolio-section__view-more) {
      font-size: var(--font-size-body-desktop);
      flex-direction: column;
    }
  }
</style>
